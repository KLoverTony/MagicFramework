<?xml version="1.0" encoding="utf-8" ?>
<Defs>

  <FleshTypeDef>
    <defName>AF_SpectralFlesh</defName>
    <corpseCategory>CorpsesAnimal</corpseCategory>
    <damageEffecter>Damage_HitFlesh</damageEffecter>
    <isOrganic>false</isOrganic>
    <genericWounds>
      <li>
        <texture>Things/Pawn/Wounds/WoundMechA</texture>
      </li>
      <li>
        <texture>Things/Pawn/Wounds/WoundMechB</texture>
      </li>
      <li>
        <texture>Things/Pawn/Wounds/WoundMechC</texture>
      </li>
    </genericWounds>
  </FleshTypeDef>

  <ThingDef ParentName="BasePawn">
    <defName>AF_SpectreRace</defName>
    <label>spectre</label>
    <description>A disembodied spirit bound to the mortal world, made briefly visible through the Animara rite. It has no flesh, no hunger, and no will of its own — only an echo of the life it once carried.</description>
    <generateAllowChance>0</generateAllowChance>
    <modExtensions>
      <li Class="MagicFramework.PawnLifecycle.PawnLifecycleExtension">
        <bodyForm>Spectral</bodyForm>
        <intelligence>PartialIdentity</intelligence>
        <needsPolicy>NoFoodNoRest</needsPolicy>
        <socialPolicy>SuppressedBothWays</socialPolicy>
        <gearPolicy>StripAll</gearPolicy>
        <controlPolicy>AutonomousGuest</controlPolicy>
        <workPolicy>None</workPolicy>
        <recoveryPolicy>None</recoveryPolicy>
        <deathPolicy>Vanish</deathPolicy>
        <soulPolicy>ActiveSpirit</soulPolicy>
        <durationPolicy>AnchorUpkeep</durationPolicy>
        <isUndead>true</isUndead>
        <isSpirit>true</isSpirit>
        <enforceNeeds>true</enforceNeeds>
        <enforceSocialPolicy>true</enforceSocialPolicy>
        <enforceGearPolicy>true</enforceGearPolicy>
        <enforceControlPolicy>true</enforceControlPolicy>
        <enforceWorkPolicy>true</enforceWorkPolicy>
        <clearGeneratedHealthState>true</clearGeneratedHealthState>
        <enforceLifeStage>true</enforceLifeStage>
        <enforceMarkers>true</enforceMarkers>
        <markerHediffs>
          <li>AF_UndeadNature</li>
          <li>AF_SpectralForm</li>
          <li>AF_SpectralLimitations</li>
        </markerHediffs>
        <lifecycleTraits>
          <li>MF_Lifecycle_NoWork</li>
        </lifecycleTraits>
        <suppressedThoughts>
          <li>EnvironmentDark</li>
          <li>Naked</li>
          <li>HappyNude</li>
          <li>ApparelDamaged</li>
          <li>WrongApparelGender</li>
          <li>DeadMansApparel</li>
          <li>IdeoRoleApparelRequirementNotMet</li>
          <li>GroinUncovered_Disapproved_Male</li>
          <li>GroinUncovered_Disapproved_Female</li>
          <li>GroinUncovered_Disapproved_Social_Male</li>
          <li>GroinUncovered_Disapproved_Social_Female</li>
          <li>GroinOrChestUncovered_Disapproved_Male</li>
          <li>GroinOrChestUncovered_Disapproved_Female</li>
          <li>GroinOrChestUncovered_Disapproved_Social_Male</li>
          <li>GroinOrChestUncovered_Disapproved_Social_Female</li>
          <li>GroinChestOrHairUncovered_Disapproved_Male</li>
          <li>GroinChestOrHairUncovered_Disapproved_Female</li>
          <li>GroinChestOrHairUncovered_Disapproved_Social_Male</li>
          <li>GroinChestOrHairUncovered_Disapproved_Social_Female</li>
          <li>GroinChestHairOrFaceUncovered_Disapproved_Male</li>
          <li>GroinChestHairOrFaceUncovered_Disapproved_Female</li>
          <li>GroinChestHairOrFaceUncovered_Disapproved_Social_Male</li>
          <li>GroinChestHairOrFaceUncovered_Disapproved_Social_Female</li>
        </suppressedThoughts>
      </li>
    </modExtensions>

    <!-- Humanlike pawns do not use this top-level graphicData for their body.
         The torso/body texture is supplied through a BodyTypeDef below. -->

    <soundImpactDefault>BulletImpact_Flesh</soundImpactDefault>

    <statBases>
      <MarketValue>0</MarketValue>
      <Mass>0</Mass>
      <MoveSpeed>3.2</MoveSpeed>
      <Flammability>0</Flammability>
      <ArmorRating_Blunt>0</ArmorRating_Blunt>
      <ArmorRating_Sharp>0</ArmorRating_Sharp>
      <ArmorRating_Heat>1</ArmorRating_Heat>
      <ComfyTemperatureMin>-100</ComfyTemperatureMin>
      <ComfyTemperatureMax>100</ComfyTemperatureMax>
      <PsychicSensitivity>2</PsychicSensitivity>
      <GlobalLearningFactor>0</GlobalLearningFactor>
      <ToxicResistance>1</ToxicResistance>
      <ToxicEnvironmentResistance>1</ToxicEnvironmentResistance>
      <MeatAmount>0</MeatAmount>
      <LeatherAmount>0</LeatherAmount>
    </statBases>

    <race>
      <thinkTreeMain>AF_Spectre</thinkTreeMain>
      <thinkTreeConstant>HumanlikeConstant</thinkTreeConstant>
      <intelligence>Humanlike</intelligence>
      <!-- Keep this humanlike. Animal render nodes call CurKindLifeStage and will error on humanlike pawns. -->
      <renderTree>Humanlike</renderTree>
      <body>Human</body>
      <baseBodySize>0.8</baseBodySize>
      <baseHealthScale>0.6</baseHealthScale>
      <foodType>None</foodType>
      <baseHungerRate>0</baseHungerRate>
      <needsRest>false</needsRest>
      <hasMeat>false</hasMeat>
      <hasGenders>true</hasGenders>
      <nameCategory>NoName</nameCategory>
      <nameGenerator>NamerAnimalGenericMale</nameGenerator>
      <nameGeneratorFemale>NamerAnimalGenericFemale</nameGeneratorFemale>
      <alwaysAwake>true</alwaysAwake>
      <isImmuneToInfections>true</isImmuneToInfections>
      <bleedRateFactor>0</bleedRateFactor>
      <lifeExpectancy>2000</lifeExpectancy>
      <fleshType>AF_SpectralFlesh</fleshType>
      <makesFootprints>false</makesFootprints>
      <manhunterOnDamageChance>0</manhunterOnDamageChance>
      <manhunterOnTameFailChance>0</manhunterOnTameFailChance>
      <soundMeleeDodge>Pawn_MeleeDodge</soundMeleeDodge>
      <ageGenerationCurve>
        <points>
          <li>(0, 0)</li>
          <li>(1, 100)</li>
          <li>(2000, 0)</li>
        </points>
      </ageGenerationCurve>
      <lifeStageAges>
        <li>
          <def>AF_UndeadFullyFormed</def>
          <minAge>0</minAge>
        </li>
      </lifeStageAges>
    </race>

    <!-- Spirits should not butcher into mechanoid resources. -->

    <comps>
      <li Class="MagicFramework.PawnLifecycle.CompProperties_PawnLifecycleEnforcer" />
      <li Class="AeternusFaith.CompProperties_SkeletonUndeadCleanup" />
    </comps>

  </ThingDef>

  <!--
    Body texture setup:
    Rename/place your three torso textures like this:
      Textures/Things/Undead/Spectre/SpectreBody_south.png  = front
      Textures/Things/Undead/Spectre/SpectreBody_north.png  = back
      Textures/Things/Undead/Spectre/SpectreBody_east.png   = side
    RimWorld mirrors east for west.
  -->
  <BodyTypeDef>
    <defName>AF_SpectreBody</defName>
    <label>spectral body</label>
    <bodyNakedGraphicPath>Things/Undead/Spectre/SpectreBody</bodyNakedGraphicPath>
    <bodyDessicatedGraphicPath>Things/Undead/Spectre/SpectreBody</bodyDessicatedGraphicPath>
    <bodyGraphicScale>(0.6, 1)</bodyGraphicScale>
    <woundAnchors />
  </BodyTypeDef>

  <!--
    Optional but recommended: add transparent head textures so the humanlike render tree
    does not draw a normal human head over the spectral torso.

    Expected files:
      Textures/Things/Undead/Spectre/SpectreHead_south.png
      Textures/Things/Undead/Spectre/SpectreHead_north.png
      Textures/Things/Undead/Spectre/SpectreHead_east.png
  -->
  <HeadTypeDef>
    <defName>AF_SpectreHead</defName>
    <label>spectral head</label>
    <graphicPath>Things/Undead/Spectre/SpectreHead</graphicPath>
    <selectionWeight>0</selectionWeight>
    <randomChosen>false</randomChosen>
    <gender>Male</gender>
  </HeadTypeDef>

</Defs>
