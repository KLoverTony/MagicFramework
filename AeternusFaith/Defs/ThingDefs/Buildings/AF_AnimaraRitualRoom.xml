<?xml version="1.0" encoding="utf-8" ?>
<Defs>

  <!-- Base class for Animara floor coverings -->
  <ThingDef Name="AF_AnimaraFloorBase" ParentName="BuildingBase" Abstract="True">
    <thingClass>Building</thingClass>
    <category>Building</category>
    <altitudeLayer>FloorCoverings</altitudeLayer>
    <passability>Standable</passability>
    <pathCost>0</pathCost>
    <fillPercent>0</fillPercent>
    <selectable>true</selectable>
    <useHitPoints>true</useHitPoints>
    <terrainAffordanceNeeded>Light</terrainAffordanceNeeded>
    <designationCategory>Misc</designationCategory>
    <blocksAltitudes>
      <li>FloorCoverings</li>
    </blocksAltitudes>
    <statBases>
      <MaxHitPoints>80</MaxHitPoints>
      <WorkToBuild>400</WorkToBuild>
      <Flammability>0.3</Flammability>
      <Beauty>2</Beauty>
      <Mass>10</Mass>
    </statBases>
    <costList>
      <Cloth>30</Cloth>
      <Steel>10</Steel>
    </costList>
    <building>
      <isEdifice>false</isEdifice>
      <isInert>true</isInert>
      <ai_chillDestination>false</ai_chillDestination>
    </building>
  </ThingDef>

  <!-- Center Piece -->
  <ThingDef ParentName="AF_AnimaraFloorBase">
    <defName>AF_AnimaraRitualCenter</defName>
    <label>animara ritual center</label>
    <description>The central focal point of the Animara ritual room floor.</description>
    <graphicData>
      <texPath>Things/RitualRoom/Animara_Ritual_center</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <drawSize>(4,3)</drawSize>
    </graphicData>
    <size>(4,3)</size>
    <uiOrder>2070</uiOrder>
    <rotatable>false</rotatable>
    <statBases>
      <WorkToBuild>800</WorkToBuild>
      <Beauty>5</Beauty>
    </statBases>
    <costList>
      <Cloth>60</Cloth>
      <Steel>20</Steel>
    </costList>
    <comps>
      <li Class="AeternusFaith.CompProperties_PlaceLinkedBuildable">
        <targetDef>AF_OssuaryBoneBox</targetDef>
        <offset>(0,0,0)</offset>
        <commandLabel>Build ossuary bone box</commandLabel>
        <commandDescription>Place a normal construction blueprint for an ossuary bone box in the center of this circle.</commandDescription>
        <commandIconPath>Things/Graves/OssuaryBox_south</commandIconPath>
      </li>
      <!-- Gizmo that places blueprints for all surrounding ritual room pieces -->
      <li Class="AeternusFaith.CompProperties_PlaceRitualRoomBlueprints">
        <commandLabel>Place ritual room blueprints</commandLabel>
        <commandDescription>Place construction blueprints for all surrounding Animara ritual room pieces (edges and corners). Already-built or already-blueprinted pieces are skipped.</commandDescription>
        <commandIconPath>UI/Commands/AddToArea</commandIconPath>
        <pieces>
          <!-- Top edge (4x2): directly above center (center is 4 wide, 3 tall) -->
          <li>
            <def>AF_AnimaraRitualEdge_Top</def>
            <offset>(0,0,2)</offset>
          </li>
          <!-- Bottom edge (4x2): directly below center -->
          <li>
            <def>AF_AnimaraRitualEdge_Bottom</def>
            <offset>(0,0,-3)</offset>
          </li>
          <!-- Left edge (2x3): directly left of center (center is 4 wide) -->
          <li>
            <def>AF_AnimaraRitualEdge_Left</def>
            <offset>(-3,0,0)</offset>
          </li>
          <!-- Right edge (2x3): directly right of center -->
          <li>
            <def>AF_AnimaraRitualEdge_Right</def>
            <offset>(3,0,0)</offset>
          </li>
          <!-- Top-left corner (2x2) -->
          <li>
            <def>AF_AnimaraRitualCorner_TL</def>
            <offset>(-3,0,2)</offset>
          </li>
          <!-- Top-right corner (2x2) -->
          <li>
            <def>AF_AnimaraRitualCorner_TR</def>
            <offset>(3,0,2)</offset>
          </li>
          <!-- Bottom-left corner (2x2) -->
          <li>
            <def>AF_AnimaraRitualCorner_BL</def>
            <offset>(-3,0,-3)</offset>
          </li>
          <!-- Bottom-right corner (2x2) -->
          <li>
            <def>AF_AnimaraRitualCorner_BR</def>
            <offset>(3,0,-3)</offset>
          </li>
        </pieces>
      </li>
    </comps>
  </ThingDef>

  <!-- Top Edge Piece -->
  <ThingDef ParentName="AF_AnimaraFloorBase">
    <defName>AF_AnimaraRitualEdge_Top</defName>
    <label>animara ritual edge (top)</label>
