<?xml version="1.0" encoding="utf-8" ?>
<Defs>

  <ThingDef ParentName="BuildingBase">
    <defName>AF_OssanithCircle</defName>
    <label>ossanith circle</label>
    <description>A sealed Ossanith ritual circle laid across the floor, prepared to receive a bone box at its center.</description>
    <thingClass>Building</thingClass>
    <category>Building</category>
    <graphicData>
      <texPath>Things/RitualRooms/OssanithRitualRoom/AF_OssanithCircle</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <drawSize>(3,3)</drawSize>
    </graphicData>
    <minifiedDef>MinifiedThing</minifiedDef>
    <size>(3,3)</size>
    <altitudeLayer>FloorCoverings</altitudeLayer>
    <passability>Standable</passability>
    <pathCost>0</pathCost>
    <fillPercent>0</fillPercent>
    <selectable>true</selectable>
    <useHitPoints>true</useHitPoints>
    <rotatable>false</rotatable>
    <terrainAffordanceNeeded>Light</terrainAffordanceNeeded>
    <designationCategory>Misc</designationCategory>
    <uiOrder>2060</uiOrder>
    <researchPrerequisites>
      <li>AF_OssanithTraditions</li>
    </researchPrerequisites>
    <thingCategories>
      <li>BuildingsMisc</li>
    </thingCategories>
    <blocksAltitudes>
      <li>FloorCoverings</li>
    </blocksAltitudes>
    <statBases>
      <MaxHitPoints>80</MaxHitPoints>
      <WorkToBuild>800</WorkToBuild>
      <Flammability>0.32</Flammability>
      <Beauty>4</Beauty>
      <Mass>20</Mass>
    </statBases>
    <costList>
      <Cloth>60</Cloth>
      <Steel>20</Steel>
    </costList>
    <building>
      <isEdifice>false</isEdifice>
      <isInert>true</isInert>
      <ai_chillDestination>false</ai_chillDestination>
    </building>
    <comps>
      <li Class="AeternusFaith.CompProperties_PlaceLinkedBuildable">
        <targetDef>AF_OssuaryBoneBox</targetDef>
        <offset>(0,0,0)</offset>
        <commandLabel>Build ossuary bone box</commandLabel>
        <commandDescription>Place a normal construction blueprint for an ossuary bone box in the center of this circle.</commandDescription>
        <commandIconPath>Things/Graves/OssuaryBox_south</commandIconPath>
      </li>
      <li Class="AeternusFaith.CompProperties_BonewrightAnointment">
        <commandIconPath>Things/RitualRooms/OssanithRitualRoom/AF_OssanithCircle</commandIconPath>
      </li>
    </comps>
  </ThingDef>

  <ThingDef ParentName="BuildingBase">
    <defName>AF_OssuaryBoneBox</defName>
    <label>ossuary bone box</label>
    <description>A small Ossanith bone box for a sealed ossuary rite. Once filled, it can be placed within an alcove wall.</description>
    <thingClass>Building</thingClass>
    <category>Building</category>
    <graphicData>
      <texPath>Things/Graves/OssuaryBox</texPath>
      <graphicClass>Graphic_Multi</graphicClass>
      <drawSize>(1,1)</drawSize>
    </graphicData>
    <minifiedDef>MinifiedThing</minifiedDef>
    <size>(1,1)</size>
    <altitudeLayer>Building</altitudeLayer>
    <passability>PassThroughOnly</passability>
    <pathCost>30</pathCost>
    <fillPercent>0.35</fillPercent>
    <selectable>true</selectable>
    <useHitPoints>true</useHitPoints>
    <rotatable>true</rotatable>
    <defaultPlacingRot>South</defaultPlacingRot>
    <terrainAffordanceNeeded>Light</terrainAffordanceNeeded>
    <designationCategory>Misc</designationCategory>
    <uiOrder>2061</uiOrder>
    <researchPrerequisites>
      <li>AF_OssanithTraditions</li>
    </researchPrerequisites>
    <thingCategories>
      <li>BuildingsMisc</li>
    </thingCategories>
    <statBases>
      <MaxHitPoints>120</MaxHitPoints>
      <WorkToBuild>600</WorkToBuild>
      <Flammability>0.2</Flammability>
      <Beauty>2</Beauty>
      <Mass>18</Mass>
    </statBases>
    <costList>
      <BlocksGranite>35</BlocksGranite>
      <Steel>10</Steel>
    </costList>
    <building>
      <isInert>true</isInert>
      <ai_chillDestination>false</ai_chillDestination>
    </building>
    <comps>
      <li Class="AeternusFaith.CompProperties_OssuaryObituary"/>
      <li Class="AeternusFaith.CompProperties_PlaceOssuaryInAlcove">
        <graniteAlcoveWallDef>AF_AlcoveWallGranite</graniteAlcoveWallDef>
        <slateAlcoveWallDef>AF_AlcoveWallSlate</slateAlcoveWallDef>
        <filledGraniteAlcoveWallDef>AF_AlcoveWallFilledGranite</filledGraniteAlcoveWallDef>
        <filledSlateAlcoveWallDef>AF_AlcoveWallFilledSlate</filledSlateAlcoveWallDef>
      </li>
    </comps>
  </ThingDef>

  <ThingDef ParentName="BuildingBase">
    <defName>AF_OssanithLectern</defName>
    <label>bonewright lectern</label>
    <description>A ceremonial lectern used by Bonewrights for cathedra rites. It recognizes adjacent ritual circles and exposes the rites appropriate to each circle.</description>

    <thingClass>Building</thingClass>
    <category>Building</category>

    <graphicData>
      <texPath>Things/RitualLectern/Ossanith_Lectern</texPath>
      <graphicClass>Graphic_Multi</graphicClass>
      <drawSize>(1,1)</drawSize>
    </graphicData>

    <drawerType>MapMeshOnly</drawerType>
    <minifiedDef>MinifiedThing</minifiedDef>

    <size>(1,1)</size>
    <altitudeLayer>Building</altitudeLayer>

    <passability>PassThroughOnly</passability>
    <pathCost>30</pathCost>
    <fillPercent>0.35</fillPercent>

    <selectable>true</selectable>
    <useHitPoints>true</useHitPoints>

    <rotatable>true</rotatable>
    <defaultPlacingRot>South</defaultPlacingRot>
    <hasInteractionCell>true</hasInteractionCell>
    <interactionCellOffset>(0,0,-1)</interactionCellOffset>

    <terrainAffordanceNeeded>Light</terrainAffordanceNeeded>

    <designationCategory>Misc</designationCategory>
    <uiOrder>2061</uiOrder>
    <researchPrerequisites>
      <li>AF_OssanithTraditions</li>
    </researchPrerequisites>

    <thingCategories>
      <li>BuildingsFurniture</li>
    </thingCategories>

    <statBases>
      <MaxHitPoints>140</MaxHitPoints>
      <WorkToBuild>700</WorkToBuild>
      <Flammability>0.20</Flammability>
      <Beauty>5</Beauty>
      <Mass>25</Mass>
    </statBases>

    <costList>
      <WoodLog>45</WoodLog>
    </costList>

    <building>
      <isInert>true</isInert>
      <ai_chillDestination>false</ai_chillDestination>
    </building>

    <surfaceType>Item</surfaceType>

    <comps>
      <li Class="CompProperties_Forbiddable"/>
      <li Class="AeternusFaith.CompProperties_BonewrightLecternRitualFallback">
        <supportedCircleDefs>
          <li>AF_OssanithCircle</li>
          <li>AF_AnimaraRitualCenter</li>
          <li>AF_ChoralumCircle</li>
          <li>AF_ShroudhymnRitualCenter</li>
        </supportedCircleDefs>
        <commandIconPath>Things/RitualLectern/Ossanith_Lectern</commandIconPath>
      </li>

      <li Class="AeternusFaith.CompProperties_OssanithOssuaryRitual">
        <circleDef>AF_OssanithCircle</circleDef>
        <ossuaryDef>AF_OssuaryBoneBox</ossuaryDef>
        <commandLabel>Begin ossuary rite</commandLabel>
        <commandDescription>Begin an Ossanith ossuary rite. Requires an orthogonally adjacent Ossanith circle with an empty ossuary in its center.</commandDescription>
        <commandIconPath>Things/Graves/OssuaryBox_south</commandIconPath>
        <hideWhenCircleAbsent>true</hideWhenCircleAbsent>
      </li>

      <li Class="AeternusFaith.CompProperties_OssanithSkeletonRitual">
        <circleDef>AF_OssanithCircle</circleDef>
        <commandLabel>Animate Ossanith Skeleton</commandLabel>
        <commandDescription>Begin an Ossanith rite to animate a corpse as an Ossanith Skeleton. Requires an orthogonally adjacent Ossanith circle.</commandDescription>
        <commandIconPath>Things/RitualRooms/OssanithRitualRoom/AF_OssanithCircle</commandIconPath>
        <hideWhenCircleAbsent>true</hideWhenCircleAbsent>
      </li>

      <li Class="AeternusFaith.CompProperties_OssanithOssuaryRitual">
        <circleDef>AF_AnimaraRitualCenter</circleDef>
        <ossuaryDef>AF_OssuaryBoneBox</ossuaryDef>
        <commandLabel>Begin animara ossuary rite</commandLabel>
        <commandDescription>Begin an Animara ossuary rite. Requires an orthogonally adjacent Animara ritual center with a completed ossuary in its center.</commandDescription>
        <commandIconPath>Things/Graves/OssuaryBox_south</commandIconPath>
        <hideWhenCircleAbsent>true</hideWhenCircleAbsent>
      </li>

      <li Class="AeternusFaith.CompProperties_AnimaraRevenantRitual">
        <circleDef>AF_AnimaraRitualCenter</circleDef>
        <commandLabel>Animate Echobound Revenant</commandLabel>
        <commandDescription>Begin an Animara rite to animate a corpse as an Echobound Revenant. Requires an orthogonally adjacent Animara ritual center.</commandDescription>
        <commandIconPath>Things/RitualRooms/AnimaraRitualRoom/Animara_Ritual_center</commandIconPath>
        <hideWhenCircleAbsent>true</hideWhenCircleAbsent>
      </li>

      <li Class="AeternusFaith.CompProperties_OssanithOssuaryRitual">
        <circleDef>AF_ChoralumCircle</circleDef>
        <ossuaryDef>AF_OssuaryBoneBox</ossuaryDef>
        <commandLabel>Begin choralum ossuary rite</commandLabel>
        <commandDescription>Begin a Choralum ossuary rite. Requires an orthogonally adjacent Choralum circle with a completed ossuary in its center.</commandDescription>
        <commandIconPath>Things/Graves/OssuaryBox_south</commandIconPath>
        <hideWhenCircleAbsent>true</hideWhenCircleAbsent>
      </li>

      <li Class="AeternusFaith.CompProperties_ChoralumWardenRitual">
        <circleDef>AF_ChoralumCircle</circleDef>
        <armorDefs>
          <li>Apparel_PlateArmor</li>
          <li>Apparel_FlakVest</li>
          <li>Apparel_FlakJacket</li>
        </armorDefs>
        <commandLabel>Animate Reliquary Warden</commandLabel>
        <commandDescription>Begin a Choralum rite to animate a corpse and suit of armor as a Reliquary Warden. Requires plate armor or flak armor near the circle.</commandDescription>
        <commandIconPath>Things/RitualRooms/ChoralumRitualRoom/Choralum_Ritual_center</commandIconPath>
        <hideWhenCircleAbsent>true</hideWhenCircleAbsent>
      </li>

      <li Class="AeternusFaith.CompProperties_OssanithOssuaryRitual">
        <circleDef>AF_ShroudhymnRitualCenter</circleDef>
        <ossuaryDef>AF_OssuaryBoneBox</ossuaryDef>
        <commandLabel>Begin Shroudhymn ossuary rite</commandLabel>
        <commandDescription>Begin a Shroudhymn ossuary rite. Requires an orthogonally adjacent Shroudhymn ritual center with a completed ossuary in its center.</commandDescription>
        <commandIconPath>Things/Graves/OssuaryBox_south</commandIconPath>
        <hideWhenCircleAbsent>true</hideWhenCircleAbsent>
      </li>

      <li Class="AeternusFaith.Undead.Spectral.CompProperties_SummonSpectre">
        <circleDef>AF_ShroudhymnRitualCenter</circleDef>
        <commandLabel>Animate Veilbound Shade</commandLabel>
        <commandDescription>Begin a Shroudhymn rite to animate a corpse as a Veilbound Shade at the adjacent ritual center.</commandDescription>
        <commandIconPath>Things/RitualRooms/ShroudhymnRitualRoom/Shroudhymn_Ritual_center</commandIconPath>
        <hideWhenCircleAbsent>true</hideWhenCircleAbsent>
      </li>
    </comps>

  </ThingDef>

</Defs>
