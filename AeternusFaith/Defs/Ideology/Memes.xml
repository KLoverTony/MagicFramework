  <MemeDef>
    <defName>AET_CosmicBalance</defName>
    <label>cosmic balance</label>
    <description>Life and death, light and shadow, wildness and order are all sacred. To enthrone one principle above the others is the first step toward ruin.</description>
    <impact>2</impact>
    <displayOrder>1000</displayOrder>
    <iconPath>UI/Ideoligions/Memes/AET_CosmicBalance</iconPath>
    <styleCategories>
      <li>AET_EternalBalance</li>
    </styleCategories>
    <symbolPack>AET_EternalBalance</symbolPack>
