<?xml version="1.0" encoding="utf-8" ?>
<Defs>

  <HediffDef>
    <defName>AF_UndeadNature</defName>
    <label>undead nature</label>
    <description>This pawn carries the shared metaphysical state of undeath.</description>
    <hediffClass>Hediff</hediffClass>
    <isBad>false</isBad>
    <scenarioCanAdd>false</scenarioCanAdd>
  </HediffDef>

  <HediffDef>
    <defName>AF_SkeletalBody</defName>
    <label>skeletal body</label>
    <description>This pawn has a skeletal undead body.</description>
    <hediffClass>Hediff</hediffClass>
    <isBad>false</isBad>
    <scenarioCanAdd>false</scenarioCanAdd>
    <defaultLabelColor>(0.75, 0.75, 0.75)</defaultLabelColor>
  </HediffDef>

  <HediffDef>
    <defName>AF_SkeletalLimitations</defName>
    <label>skeletal limitations</label>
    <description>This skeletal body has limited awareness and dexterity.</description>
    <hediffClass>Hediff</hediffClass>
    <isBad>false</isBad>
    <scenarioCanAdd>false</scenarioCanAdd>
    <stages>
      <li>
        <capMods>
          <li>
            <capacity>Consciousness</capacity>
            <setMax>0.5</setMax>
          </li>
          <li>
            <capacity>Manipulation</capacity>
            <setMax>0.5</setMax>
          </li>
          <li>
            <capacity>Moving</capacity>
            <setMax>0.75</setMax>
          </li>
          <li>
            <capacity>Talking</capacity>
            <setMax>0</setMax>
          </li>
        </capMods>
      </li>
    </stages>
    <defaultLabelColor>(0.65, 0.65, 0.65)</defaultLabelColor>
  </HediffDef>

  <HediffDef>
    <defName>AF_SpectralForm</defName>
    <label>spectral form</label>
    <description>This pawn has an incorporeal or partially manifested undead form.</description>
    <hediffClass>Hediff</hediffClass>
    <isBad>false</isBad>
    <scenarioCanAdd>false</scenarioCanAdd>
    <defaultLabelColor>(0.45, 0.65, 0.9)</defaultLabelColor>
  </HediffDef>

  <HediffDef>
    <defName>AF_SpectralLimitations</defName>
    <label>spectral limitations</label>
    <description>This spectral body can drift freely, but has little physical control.</description>
    <hediffClass>Hediff</hediffClass>
    <isBad>false</isBad>
    <scenarioCanAdd>false</scenarioCanAdd>
    <stages>
      <li>
        <capMods>
          <li>
            <capacity>Consciousness</capacity>
            <setMax>0.75</setMax>
          </li>
          <li>
            <capacity>Manipulation</capacity>
            <setMax>0</setMax>
          </li>
          <li>
            <capacity>Moving</capacity>
            <setMax>1.25</setMax>
          </li>
          <li>
            <capacity>Talking</capacity>
            <setMax>0.25</setMax>
          </li>
        </capMods>
      </li>
    </stages>
    <defaultLabelColor>(0.45, 0.65, 0.9)</defaultLabelColor>
  </HediffDef>

  <HediffDef>
    <defName>AF_EerieCold</defName>
    <label>eerie cold</label>
    <description>A supernatural chill clings to this pawn after standing near a manifested spirit.</description>
    <hediffClass>HediffWithComps</hediffClass>
    <isBad>true</isBad>
    <scenarioCanAdd>false</scenarioCanAdd>
    <defaultLabelColor>(0.55, 0.75, 0.9)</defaultLabelColor>
    <comps>
      <li Class="HediffCompProperties_Disappears">
        <disappearsAfterTicks>900</disappearsAfterTicks>
      </li>
    </comps>
  </HediffDef>

  <HediffDef>
    <defName>AF_BonewrightOssanithInitiate</defName>
    <label>Ossanith Bonewright initiate</label>
    <description>This pawn has been anointed into the Bonewright order under the Ossanith foundation.</description>
    <hediffClass>Hediff</hediffClass>
    <isBad>false</isBad>
    <scenarioCanAdd>false</scenarioCanAdd>
    <defaultLabelColor>(0.72, 0.72, 0.66)</defaultLabelColor>
  </HediffDef>

</Defs>
