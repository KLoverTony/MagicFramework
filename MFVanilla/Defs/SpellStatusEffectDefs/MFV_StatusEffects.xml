        <statDef>MoveSpeed</statDef>
        <factor>1.12</factor>
      </li>
      <li>
        <statDef>GeneralLaborSpeed</statDef>
        <factor>1.10</factor>
      </li>
    </statModifiers>
  </MagicFramework.Definitions.SpellStatusEffectDef>

  <MagicFramework.Definitions.SpellStatusEffectDef>
    <defName>MFV_Status_Regenerating</defName>
    <label>regenerating</label>
    <description>Vital magic is knitting this pawn's wounds closed over time.</description>
    <durationTicks>720</durationTicks>
    <scalableDurationTicks>
      <baseValue>720</baseValue>
      <perPower>30</perPower>
      <max>1320</max>
