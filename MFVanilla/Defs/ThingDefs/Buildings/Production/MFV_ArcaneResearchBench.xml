<?xml version="1.0" encoding="utf-8" ?>
<Defs>

<ThingDef ParentName="BenchBase">
    <defName>MFV_ArcaneResearchBench</defName>
    <label>arcane research bench</label>
    <description>A simple workbench for recording arcane observations, comparing spell structures, and conducting early magical research.</description>
    <thingClass>Building_ResearchBench</thingClass>
    <size>(3,2)</size>
    <stuffCategories>
      <li>Metallic</li>
      <li>Woody</li>
      <li>Stony</li>
    </stuffCategories>
    <costStuffCount>75</costStuffCount>
    <costList>
      <Steel>20</Steel>
    </costList>
    <graphicData>
      <texPath>Things/Building/Production/ArcaneBench</texPath>
      <graphicClass>Graphic_Multi</graphicClass>
      <shaderType>CutoutComplex</shaderType>
      <drawSize>(3,2)</drawSize>
      <damageData>
        <cornerTL>Damage/Corner</cornerTL>
        <cornerTR>Damage/Corner</cornerTR>
        <cornerBL>Damage/Corner</cornerBL>
        <cornerBR>Damage/Corner</cornerBR>
      </damageData>
    </graphicData>
    <castEdgeShadows>true</castEdgeShadows>
    <staticSunShadowHeight>0.20</staticSunShadowHeight>
    <altitudeLayer>Building</altitudeLayer>
    <passability>PassThroughOnly</passability>
    <pathCost>50</pathCost>
    <statBases>
      <MaxHitPoints>250</MaxHitPoints>
      <WorkToBuild>2800</WorkToBuild>
      <Flammability>1.0</Flammability>
      <ResearchSpeedFactor>0.75</ResearchSpeedFactor>
    </statBases>
    <placeWorkers>
      <li>PlaceWorker_PreventInteractionSpotOverlap</li>
      <li>PlaceWorker_DrawLinesToBookcasesInRoom</li>
    </placeWorkers>
    <fillPercent>0.5</fillPercent>
    <interactionCellOffset>(0,0,-1)</interactionCellOffset>
    <hasInteractionCell>true</hasInteractionCell>
    <designationCategory>Production</designationCategory>
    <uiOrder>2602</uiOrder>
    <surfaceType>Item</surfaceType>
    <researchPrerequisites>
      <li>MFV_ArcaneTheory</li>
    </researchPrerequisites>
    <building>
      <paintable>true</paintable>
      <workTableRoomRole>Laboratory</workTableRoomRole>
      <workTableNotInRoomRoleFactor>0.8</workTableNotInRoomRoleFactor>
    </building>
    <comps Inherit="False">
      <li Class="CompProperties_ReportWorkSpeed">
        <workSpeedStat>ResearchSpeedFactor</workSpeedStat>
      </li>
      <li Class="MFVanilla.Core.CompProperties_ArcaneDisciplineRitualMarker">
        <commandLabel>Embrace discipline</commandLabel>
        <commandDescription>Begin a short rite for an Arcane Gift pawn to embrace an available Arcane Discipline.</commandDescription>
        <commandIconPath>UI/Commands/DesirePower</commandIconPath>
      </li>
    </comps>
  </ThingDef>

</Defs>

