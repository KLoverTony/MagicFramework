<?xml version="1.0" encoding="utf-8" ?>
<Defs>

  <ThingDef ParentName="BenchBase">
    <defName>MFV_ArcaneForge</defName>
    <label>arcane forge</label>
    <description>An enchantment bench with stabilizing clamps, focusing channels, and warded toolheads for binding durable magic into weapons, armor, and other high-value gear.</description>
    <thingClass>Building_WorkTable</thingClass>
    <tickerType>Normal</tickerType>
    <size>(3,3)</size>
    <stuffCategories>
      <li>Metallic</li>
      <li>Stony</li>
    </stuffCategories>
    <costStuffCount>150</costStuffCount>
    <costList>
      <Steel>160</Steel>
      <Plasteel>30</Plasteel>
      <ComponentIndustrial>8</ComponentIndustrial>
    </costList>
    <graphicData>
      <texPath>Things/Building/Production/ArcaneForge</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <shaderType>CutoutComplex</shaderType>
      <drawSize>(3,3)</drawSize>
      <damageData>
        <cornerTL>Damage/Corner</cornerTL>
        <cornerTR>Damage/Corner</cornerTR>
        <cornerBL>Damage/Corner</cornerBL>
        <cornerBR>Damage/Corner</cornerBR>
      </damageData>
    </graphicData>
    <castEdgeShadows>true</castEdgeShadows>
    <staticSunShadowHeight>0.20</staticSunShadowHeight>
    <altitudeLayer>Building</altitudeLayer>
    <passability>PassThroughOnly</passability>
    <pathCost>50</pathCost>
    <statBases>
      <MaxHitPoints>350</MaxHitPoints>
      <WorkToBuild>10000</WorkToBuild>
      <Flammability>0.4</Flammability>
      <WorkTableWorkSpeedFactor>1.0</WorkTableWorkSpeedFactor>
    </statBases>
    <fillPercent>0.5</fillPercent>
    <useHitPoints>true</useHitPoints>
    <interactionCellOffset>(0,0,0)</interactionCellOffset>
    <hasInteractionCell>true</hasInteractionCell>
    <terrainAffordanceNeeded>Heavy</terrainAffordanceNeeded>
    <designationCategory>Production</designationCategory>
    <uiOrder>2614</uiOrder>
    <surfaceType>Item</surfaceType>
    <constructionSkillPrerequisite>8</constructionSkillPrerequisite>
    <researchPrerequisites>
      <li>Fabrication</li>
      <li>MFV_Enchantment</li>
    </researchPrerequisites>
    <inspectorTabs>
      <li>ITab_Bills</li>
    </inspectorTabs>
    <building>
      <spawnedConceptLearnOpportunity>BillsTab</spawnedConceptLearnOpportunity>
      <paintable>true</paintable>
      <workTableRoomRole>Workshop</workTableRoomRole>
      <workTableNotInRoomRoleFactor>0.8</workTableNotInRoomRoleFactor>
    </building>
    <comps>
      <li Class="CompProperties_AffectedByFacilities">
        <linkableFacilities>
          <li>MFV_ArcaneSpire</li>
        </linkableFacilities>
      </li>
      <li Class="MFVanilla.Core.CompProperties_ArcaneForge">
        <requiredSpireCount>4</requiredSpireCount>
        <lightningIntervalTicksMin>300</lightningIntervalTicksMin>
        <lightningIntervalTicksMax>600</lightningIntervalTicksMax>
        <spireRadius>10</spireRadius>
        <lightningFlashFleckDef>SparkFlash</lightningFlashFleckDef>
        <syncPulseChance>0.12</syncPulseChance>
      </li>
    </comps>
    <placeWorkers>
      <li>PlaceWorker_ShowFacilitiesConnections</li>
      <li>PlaceWorker_PreventInteractionSpotOverlap</li>
    </placeWorkers>
  </ThingDef>

</Defs>
