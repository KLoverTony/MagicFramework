<?xml version="1.0" encoding="utf-8" ?>
<Defs>

  <ThingDef ParentName="TorchLamp">
    <defName>MFV_MagicTorchLamp</defName>
    <label>magic torch lamp</label>
    <description>An enchanted torch built around a fire arcane focus. It lights an area without needing refueling, and produces a small amount of heat.</description>
    <costList Inherit="False">
      <WoodLog>20</WoodLog>
      <MFV_FireArcaneFocus>1</MFV_FireArcaneFocus>
    </costList>
    <researchPrerequisites>
      <li>MFV_Enchantment</li>
    </researchPrerequisites>
    <uiOrder>2801</uiOrder>
    <comps Inherit="False">
      <li Class="CompProperties_Styleable" />
      <li Class="CompProperties_Glower">
        <glowRadius>10</glowRadius>
        <glowColor>(150,205,255,0)</glowColor>
      </li>
      <li Class="CompProperties_FireOverlay">
        <fireSize>0.4</fireSize>
        <offset>(0,0,0.2)</offset>
      </li>
      <li Class="CompProperties_HeatPusher">
        <compClass>CompHeatPusherPowered</compClass>
        <heatPerSecond>3.5</heatPerSecond>
        <heatPushMaxTemperature>23</heatPushMaxTemperature>
      </li>
      <li Class="CompProperties_MeditationFocus">
        <statDef>MeditationFocusStrength</statDef>
        <focusTypes>
          <li>Flame</li>
        </focusTypes>
        <offsets>
          <li Class="FocusStrengthOffset_Lit">
            <offset>0.1</offset>
          </li>
          <li Class="FocusStrengthOffset_BuildingDefsLit">
            <defs>
              <li>Campfire</li>
              <li>TorchLamp</li>
              <li>TorchWallLamp</li>
              <li>MFV_MagicTorchLamp</li>
              <li>MFV_MagicTorchWallLamp</li>
              <li MayRequire="Ludeon.RimWorld.Royalty">Brazier</li>
              <li MayRequire="Ludeon.RimWorld.Royalty,Ludeon.RimWorld.Ideology">DarklightBrazier</li>
              <li MayRequire="Ludeon.RimWorld.Ideology">Darktorch</li>
              <li MayRequire="Ludeon.RimWorld.Ideology">DarktorchFungus</li>
            </defs>
            <offsetPerBuilding>0.01</offsetPerBuilding>
            <radius>9.9</radius>
            <maxBuildings>8</maxBuildings>
            <explanationKey>MeditationFocusPerFlame</explanationKey>
            <explanationKeyAbstract>MeditationFocusPerFlameAbstract</explanationKeyAbstract>
            <drawRingRadius>false</drawRingRadius>
          </li>
        </offsets>
      </li>
    </comps>
  </ThingDef>

  <ThingDef ParentName="TorchLamp">
    <defName>MFV_MagicTorchWallLamp</defName>
    <label>magic wall torch lamp</label>
    <description>An enchanted wall-mounted torch built around a fire arcane focus. It lights an area without needing refueling, and produces a small amount of heat.</description>
    <rotatable>true</rotatable>
    <graphicData>
      <texPath>Things/Building/Misc/WallTorch/WallTorch</texPath>
      <graphicClass>Graphic_Multi</graphicClass>
      <drawOffsetNorth>(0,0,0.9)</drawOffsetNorth>
      <drawOffsetSouth>(0,0,-0.9)</drawOffsetSouth>
      <drawOffsetWest>(-0.9,0,0)</drawOffsetWest>
      <drawOffsetEast>(0.9,0,0)</drawOffsetEast>
      <damageData>
        <enabled>false</enabled>
      </damageData>
    </graphicData>
    <uiIconPath>Things/Building/Misc/WallTorch/WallTorch_MenuIcon</uiIconPath>
    <altitudeLayer>BuildingOnTop</altitudeLayer>
    <passability>Standable</passability>
    <terrainAffordanceNeeded IsNull="True" />
    <pathCost>0</pathCost>
    <costList Inherit="False">
      <WoodLog>15</WoodLog>
      <MFV_FireArcaneFocus>1</MFV_FireArcaneFocus>
    </costList>
    <building>
      <isEdifice>false</isEdifice>
      <isAttachment>true</isAttachment>
    </building>
    <statBases>
      <MaxHitPoints>50</MaxHitPoints>
    </statBases>
    <researchPrerequisites>
      <li>MFV_Enchantment</li>
    </researchPrerequisites>
    <uiOrder>2802</uiOrder>
    <placeWorkers>
      <li>Placeworker_AttachedToWall</li>
    </placeWorkers>
    <comps Inherit="False">
      <li Class="CompProperties_Glower">
        <glowRadius>9</glowRadius>
        <glowColor>(150,205,255,0)</glowColor>
      </li>
      <li Class="CompProperties_FireOverlay">
        <fireSize>0.4</fireSize>
        <offsetNorth>(0,0,0)</offsetNorth>
        <offsetSouth>(0,0,0.55)</offsetSouth>
        <offsetWest>(0.45,0,0.35)</offsetWest>
        <offsetEast>(-0.45,0,0.35)</offsetEast>
      </li>
      <li Class="CompProperties_Styleable" />
      <li Class="CompProperties_HeatPusher">
        <compClass>CompHeatPusherPowered</compClass>
        <heatPerSecond>3.5</heatPerSecond>
        <heatPushMaxTemperature>23</heatPushMaxTemperature>
      </li>
      <li Class="CompProperties_MeditationFocus">
        <statDef>MeditationFocusStrength</statDef>
        <focusTypes>
          <li>Flame</li>
        </focusTypes>
        <offsets>
          <li Class="FocusStrengthOffset_Lit">
            <offset>0.1</offset>
          </li>
          <li Class="FocusStrengthOffset_BuildingDefsLit">
            <defs>
              <li>Campfire</li>
              <li>TorchLamp</li>
              <li>TorchWallLamp</li>
              <li>MFV_MagicTorchLamp</li>
              <li>MFV_MagicTorchWallLamp</li>
              <li MayRequire="Ludeon.RimWorld.Royalty">Brazier</li>
              <li MayRequire="Ludeon.RimWorld.Royalty,Ludeon.RimWorld.Ideology">DarklightBrazier</li>
              <li MayRequire="Ludeon.RimWorld.Ideology">Darktorch</li>
              <li MayRequire="Ludeon.RimWorld.Ideology">DarktorchFungus</li>
            </defs>
            <offsetPerBuilding>0.01</offsetPerBuilding>
            <radius>9.9</radius>
            <maxBuildings>8</maxBuildings>
            <explanationKey>MeditationFocusPerFlame</explanationKey>
            <explanationKeyAbstract>MeditationFocusPerFlameAbstract</explanationKeyAbstract>
            <drawRingRadius>false</drawRingRadius>
          </li>
        </offsets>
      </li>
    </comps>
  </ThingDef>

</Defs>
