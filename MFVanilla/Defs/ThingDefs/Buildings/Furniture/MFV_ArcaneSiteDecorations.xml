<?xml version="1.0" encoding="utf-8" ?>
<Defs>

  <ThingDef Name="MFV_ArcaneSiteDecorationBase" ParentName="BuildingBase" Abstract="True">
    <label>arcane site decoration</label>
    <description>An arcane remnant used only as decoration in generated mission sites.</description>
    <thingClass>Building</thingClass>
    <category>Building</category>
    <selectable>false</selectable>
    <neverMultiSelect>true</neverMultiSelect>
    <graphicData>
      <graphicClass>Graphic_Single</graphicClass>
      <shaderType>CutoutComplex</shaderType>
      <drawSize>(1,1)</drawSize>
      <damageData>
        <enabled>false</enabled>
      </damageData>
    </graphicData>
    <size>(1,1)</size>
    <altitudeLayer>BuildingOnTop</altitudeLayer>
    <passability>Standable</passability>
    <fillPercent>0</fillPercent>
    <pathCost>0</pathCost>
    <useHitPoints>false</useHitPoints>
    <terrainAffordanceNeeded IsNull="True" />
    <building>
      <isEdifice>false</isEdifice>
      <deconstructible>false</deconstructible>
      <claimable>false</claimable>
    </building>
  </ThingDef>

  <ThingDef ParentName="MFV_ArcaneSiteDecorationBase">
    <defName>MFV_ArcaneSiteDecoration_A</defName>
    <label>arcane site decoration a</label>
    <graphicData>
