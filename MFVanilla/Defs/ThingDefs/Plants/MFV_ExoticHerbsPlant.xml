<?xml version="1.0" encoding="utf-8" ?>
<Defs>

  <ThingDef ParentName="PlantBase">
    <defName>Plant_MFV_ExoticHerbs</defName>
    <label>exotic herbs</label>
    <description>A cultivated magical herb used as a flexible organic base for alchemical preparations, inks, and other arcane reagents.</description>
    <statBases>
      <MaxHitPoints>70</MaxHitPoints>
      <Nutrition>0.12</Nutrition>
      <Flammability>1.2</Flammability>
    </statBases>
    <graphicData>
      <texPath>Things/Plant/ExoticHerbs</texPath>
      <graphicClass>Graphic_Single</graphicClass>
    </graphicData>
    <selectable>true</selectable>
    <pathCost>14</pathCost>
    <plant>
      <dieIfLeafless>true</dieIfLeafless>
      <harvestTag>Standard</harvestTag>
      <harvestedThingDef>MFV_ExoticHerbs</harvestedThingDef>
      <harvestYield>8</harvestYield>
      <sowTags>
        <li>Ground</li>
        <li>Hydroponic</li>
      </sowTags>
      <sowMinSkill>6</sowMinSkill>
      <sowResearchPrerequisites>
        <li>MFV_ArcaneTheory</li>
      </sowResearchPrerequisites>
      <topWindExposure>0.1</topWindExposure>
      <growDays>7.5</growDays>
      <visualSizeRange>0.45~0.9</visualSizeRange>
      <wildOrder>2</wildOrder>
      <purpose>Misc</purpose>
    </plant>
  </ThingDef>

</Defs>
