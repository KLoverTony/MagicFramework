<?xml version="1.0" encoding="utf-8" ?>
<Defs>

  <ThingDef ParentName="ChunkRockBase">
    <defName>MFV_ChunkPhaseStone</defName>
    <label>phase stone chunk</label>
    <description>A chunk of phase stone from a planar pocket. It can be ground into gemstone dust.</description>
    <graphicData>
      <color>(92,110,145)</color>
    </graphicData>
    <statBases>
      <Mass>18</Mass>
      <MarketValue>8</MarketValue>
    </statBases>
    <soundDrop>ChunkRock_Drop</soundDrop>
    <butcherProducts>
      <MFV_GemstoneDust>3</MFV_GemstoneDust>
    </butcherProducts>
  </ThingDef>

  <ThingDef ParentName="ChunkRockBase">
    <defName>MFV_ChunkVoidglass</defName>
    <label>voidglass chunk</label>
    <description>A chunk of dark planar glass. It can be ground into gemstone dust.</description>
    <graphicData>
      <color>(42,38,58)</color>
    </graphicData>
    <statBases>
      <Mass>16</Mass>
      <MarketValue>10</MarketValue>
    </statBases>
    <soundDrop>ChunkRock_Drop</soundDrop>
    <butcherProducts>
      <MFV_GemstoneDust>4</MFV_GemstoneDust>
    </butcherProducts>
  </ThingDef>

</Defs>
