<?xml version="1.0" encoding="utf-8" ?>
<Defs>

  <ThingDef ParentName="BaseMeleeWeapon_Sharp_Quality">
    <defName>MFV_FlamingLongsword</defName>
    <label>flaming longsword</label>
    <description>A longsword carrying a bound flame enchantment. Its edge burns hot enough to sear flesh and kindle targets while remaining stable in its wielder's hand.</description>
    <possessionCount>1</possessionCount>
    <graphicData>
      <texPath>Things/Item/Flaming_Sword</texPath>
      <graphicClass>Graphic_Single</graphicClass>
    </graphicData>
    <modExtensions>
      <li Class="MagicFramework.Definitions.InfoCardImageExtension">
        <imagePath>Art/Items/MFV_Art_Flaming_Sword</imagePath>
        <imageHeight>180</imageHeight>
      </li>
    </modExtensions>
    <techLevel>Medieval</techLevel>
    <weaponTags>
      <li>MedievalMeleeAdvanced</li>
      <li>LongSword</li>
      <li>MFV_MagicWeapon</li>
    </weaponTags>
    <smeltable>false</smeltable>
    <thingSetMakerTags>
      <li>RewardStandardQualitySuper</li>
    </thingSetMakerTags>
    <statBases>
      <WorkToMake>18000</WorkToMake>
      <Mass>2</Mass>
      <MarketValue>900</MarketValue>
      <MaxHitPoints>2000</MaxHitPoints>
      <Flammability>0</Flammability>
      <DeteriorationRate>0</DeteriorationRate>
    </statBases>
    <relicChance>3</relicChance>
    <equippedAngleOffset>-65</equippedAngleOffset>
    <recipeMaker IsNull="True" />
    <comps>
      <li>
        <compClass>CompQuality</compClass>
      </li>
      <li Class="CompProperties_Art">
        <nameMaker>NamerArtWeaponMelee</nameMaker>
        <descriptionMaker>ArtDescription_WeaponMelee</descriptionMaker>
        <minQualityForArtistic>Excellent</minQualityForArtistic>
      </li>
      <li Class="MagicFramework.Core.CompProperties_MagicItemAbilities">
        <fireAttachChanceFactor>0.02</fireAttachChanceFactor>
        <damageResistances>
          <li>
            <damageDef>Flame</damageDef>
            <damageFactor>0.25</damageFactor>
            <preventedHediffs>
              <li>Burn</li>
            </preventedHediffs>
            <requireEquipped>true</requireEquipped>
          </li>
        </damageResistances>
        <passiveStatuses>
          <li>
            <statusEffectDef>MFV_Status_FlameWard</statusEffectDef>
            <requireEquipped>true</requireEquipped>
          </li>
        </passiveStatuses>
      </li>
    </comps>
    <tools>
      <li>
        <label>handle</label>
        <capacities>
          <li>Blunt</li>
        </capacities>
        <power>9</power>
        <cooldownTime>2</cooldownTime>
      </li>
      <li>
        <label>point</label>
        <capacities>
          <li>Stab</li>
        </capacities>
        <power>23</power>
        <cooldownTime>2.6</cooldownTime>
        <extraMeleeDamages>
          <li>
            <def>Flame</def>
            <amount>8</amount>
            <chance>0.45</chance>
          </li>
        </extraMeleeDamages>
      </li>
      <li>
        <label>edge</label>
        <capacities>
          <li>Cut</li>
        </capacities>
        <power>23</power>
        <cooldownTime>2.6</cooldownTime>
        <extraMeleeDamages>
          <li>
            <def>Flame</def>
            <amount>8</amount>
            <chance>0.45</chance>
          </li>
        </extraMeleeDamages>
      </li>
