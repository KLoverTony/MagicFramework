<?xml version="1.0" encoding="utf-8" ?>
<Defs>

  <ThingDef Name="MFV_SpellScrollBase" Abstract="True">
    <thingClass>ThingWithComps</thingClass>
    <category>Item</category>
    <label>spell scroll</label>
    <description>A prepared arcane scroll that teaches a pawn the spell bound into its script. A pawn can use the scroll only after the scroll's prerequisites have been satisfied.</description>
    <graphicData>
      <texPath>Things/Item/Spell scroll</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <drawSize>0.8</drawSize>
    </graphicData>
    <modExtensions>
      <li Class="MagicFramework.Definitions.InfoCardImageExtension">
        <imagePath>Art/Items/MFV_Art_SpellScroll</imagePath>
        <imageHeight>180</imageHeight>
      </li>
    </modExtensions>
    <selectable>true</selectable>
    <alwaysHaulable>true</alwaysHaulable>
    <stackLimit>1</stackLimit>
    <thingCategories>
      <li>ItemsMisc</li>
    </thingCategories>
    <tradeTags>
      <li>MFV_SpellScroll</li>
    </tradeTags>
    <tradeability>All</tradeability>
    <techLevel>Neolithic</techLevel>
    <statBases>
      <MaxHitPoints>60</MaxHitPoints>
      <MarketValue>300</MarketValue>
      <Mass>0.05</Mass>
      <Flammability>1.0</Flammability>
      <DeteriorationRate>2</DeteriorationRate>
    </statBases>
    <comps>
      <li Class="CompProperties_Forbiddable" />
      <li Class="CompProperties_Usable">
        <useJob>UseItem</useJob>
        <useLabel>Read scroll</useLabel>
      </li>
      <li Class="CompProperties_UseEffectDestroySelf" />
    </comps>
  </ThingDef>

</Defs>
