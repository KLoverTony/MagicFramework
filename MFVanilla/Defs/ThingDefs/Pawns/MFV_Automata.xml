  <ThingDef ParentName="BaseMechanoidWalker">
    <defName>MFV_ClayAutomaton</defName>
    <label>clay automaton</label>
    <description>A blunt clay guardian shaped by old warding rites. Its rune-core is simple, but the body is tireless, obedient, and dangerously strong at close range.</description>
    <statBases>
      <MarketValue>650</MarketValue>
      <MoveSpeed>2.8</MoveSpeed>
      <ArmorRating_Blunt>0.24</ArmorRating_Blunt>
      <ArmorRating_Sharp>0.32</ArmorRating_Sharp>
      <ArmorRating_Heat>1.20</ArmorRating_Heat>
      <PsychicSensitivity>0.25</PsychicSensitivity>
    </statBases>
    <tools>
      <li>
        <label>left fist</label>
        <labelNoLocation>fist</labelNoLocation>
        <capacities>
          <li>Blunt</li>
