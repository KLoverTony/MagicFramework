<?xml version="1.0" encoding="utf-8" ?>
<Defs>

  <ThingDef ParentName="BaseMechanoidWalker">
    <defName>MFV_Skeleton</defName>
    <label>skeleton</label>
    <description>A brittle undead servant assembled from grave-bone and held upright by necromantic command. It has no hunger, fear, or comfort, but the spell sustaining it eventually collapses.</description>
    <statBases>
      <MarketValue>450</MarketValue>
      <MoveSpeed>3.7</MoveSpeed>
      <ArmorRating_Blunt>0.12</ArmorRating_Blunt>
      <ArmorRating_Sharp>0.42</ArmorRating_Sharp>
      <ArmorRating_Heat>0.15</ArmorRating_Heat>
      <PsychicSensitivity>0</PsychicSensitivity>
      <ToxicResistance>1</ToxicResistance>
      <ToxicEnvironmentResistance>1</ToxicEnvironmentResistance>
      <Flammability>0.25</Flammability>
    </statBases>
    <tools>
      <li>
        <label>left claw</label>
        <labelNoLocation>claw</labelNoLocation>
        <capacities>
          <li>Scratch</li>
          <li>Stab</li>
        </capacities>
        <power>10</power>
        <cooldownTime>1.75</cooldownTime>
        <linkedBodyPartsGroup>LeftHand</linkedBodyPartsGroup>
        <alwaysTreatAsWeapon>true</alwaysTreatAsWeapon>
      </li>
      <li>
        <label>right claw</label>
        <labelNoLocation>claw</labelNoLocation>
        <capacities>
          <li>Scratch</li>
          <li>Stab</li>
        </capacities>
        <power>10</power>
        <cooldownTime>1.75</cooldownTime>
        <linkedBodyPartsGroup>RightHand</linkedBodyPartsGroup>
        <alwaysTreatAsWeapon>true</alwaysTreatAsWeapon>
      </li>
      <li>
        <label>skull</label>
        <capacities>
          <li>Blunt</li>
        </capacities>
        <power>6</power>
        <cooldownTime>2</cooldownTime>
        <linkedBodyPartsGroup>HeadAttackTool</linkedBodyPartsGroup>
        <ensureLinkedBodyPartsGroupAlwaysUsable>true</ensureLinkedBodyPartsGroupAlwaysUsable>
        <chanceFactor>0.15</chanceFactor>
      </li>
    </tools>
    <race>
      <body>Human</body>
      <baseBodySize>0.85</baseBodySize>
      <baseHealthScale>0.72</baseHealthScale>
      <lifeStageAges Inherit="False">
        <li>
          <def>MechanoidFullyFormed</def>
          <minAge>0</minAge>
          <soundWounded>Pawn_Mech_Scyther_Wounded</soundWounded>
          <soundDeath>Pawn_Mech_Scyther_Death</soundDeath>
          <soundCall>Pawn_Mech_Scyther_Call</soundCall>
        </li>
      </lifeStageAges>
      <soundMeleeHitPawn>Pawn_Melee_MechanoidSlash_HitPawn</soundMeleeHitPawn>
      <soundMeleeHitBuilding>Pawn_Melee_MechanoidSlash_HitBuilding</soundMeleeHitBuilding>
      <soundMeleeMiss>Pawn_Melee_MechanoidSlash_Miss</soundMeleeMiss>
      <detritusLeavings />
    </race>
    <butcherProducts Inherit="False">
      <MFV_GemstoneDust>1</MFV_GemstoneDust>
    </butcherProducts>
  </ThingDef>

  <PawnKindDef ParentName="BaseMechanoidKind">
    <defName>MFV_Skeleton</defName>
    <label>skeleton</label>
    <labelPlural>skeletons</labelPlural>
    <race>MFV_Skeleton</race>
    <combatPower>55</combatPower>
    <lifeStages>
      <li>
        <bodyGraphicData>
          <texPath>Things/Pawn/Undead/Skeleton/Skeleton</texPath>
          <graphicClass>Graphic_Multi</graphicClass>
          <drawSize>1.15</drawSize>
          <shadowData>
            <volume>(0.22, 0.5, 0.22)</volume>
          </shadowData>
        </bodyGraphicData>
      </li>
    </lifeStages>
    <weaponMoney>0~0</weaponMoney>
    <defendPointRadius>0</defendPointRadius>
    <weaponTags />
    <techHediffsChance>0</techHediffsChance>
  </PawnKindDef>

</Defs>
