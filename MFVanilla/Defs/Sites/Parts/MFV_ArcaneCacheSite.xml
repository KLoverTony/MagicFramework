    <label>arcane cache</label>
    <roomWidth>13</roomWidth>
    <roomHeight>13</roomHeight>
    <layoutShape>Circle</layoutShape>
    <floorDef>TileSandstone</floorDef>
    <wallStuff>BlocksSandstone</wallStuff>
    <wallStuffOptions>
      <li>BlocksSandstone</li>
      <li>BlocksGranite</li>
      <li>BlocksMarble</li>
      <li>BlocksLimestone</li>
      <li>BlocksSlate</li>
    </wallStuffOptions>
    <towerWallStuffOptions>
      <li>BlocksMarble</li>
      <li>BlocksSandstone</li>
    </towerWallStuffOptions>
    <doorDef>Door</doorDef>
    <chestThingDef>MFV_ArcaneTreasureChest</chestThingDef>
    <defenderCount>3</defenderCount>
    <defenderPawnKinds>
      <li>MFV_ClayAutomaton</li>
      <li>MFV_RuneSlasherAutomaton</li>
      <li>MFV_CrystalSentinel</li>
    </defenderPawnKinds>
    <dressing>
      <li>
        <thingDef>MFV_MagicTorchLamp</thingDef>
        <offsetX>3</offsetX>
        <offsetZ>3</offsetZ>
      </li>
      <li>
        <thingDef>MFV_MagicTorchLamp</thingDef>
        <offsetX>9</offsetX>
        <offsetZ>3</offsetZ>
      </li>
      <li>
        <thingDef>MFV_ArcaneSpire</thingDef>
        <offsetX>3</offsetX>
        <offsetZ>9</offsetZ>
      </li>
      <li>
        <thingDef>MFV_ArcaneSpire</thingDef>
        <offsetX>9</offsetX>
        <offsetZ>9</offsetZ>
      </li>
    </dressing>
    <addEntryPath>true</addEntryPath>
    <entryPathLength>5</entryPathLength>
    <addExteriorRuin>true</addExteriorRuin>
    <exteriorRuinCount>6</exteriorRuinCount>
  </MFVanilla.Core.ArcaneSiteProfileDef>

