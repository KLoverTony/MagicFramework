  <SitePartDef>
    <defName>MFV_ArcaneCache</defName>
    <label>arcane cache</label>
    <description>A small sealed arcane cache guarded by dormant defense constructs.</description>
    <workerClass>MFVanilla.Core.SitePartWorker_ArcaneCache</workerClass>
    <siteTexture>World/WorldObjects/Sites/GenericSite</siteTexture>
    <expandingIconTexture>World/WorldObjects/Expanding/Sites/ItemStash</expandingIconTexture>
    <arrivedLetter>An arcane cache lies nearby. Its old defense systems still appear active.</arrivedLetter>
    <arrivedLetterDef>NeutralEvent</arrivedLetterDef>
    <wantsThreatPoints>true</wantsThreatPoints>
    <minThreatPoints>250</minThreatPoints>
    <handlesWorldObjectTimeoutInspectString>true</handlesWorldObjectTimeoutInspectString>
    <gravShipsCanLandOn>true</gravShipsCanLandOn>
    <tags>
      <li>MFV_ArcaneCache</li>
    </tags>
  </SitePartDef>

  <SitePartDef>
    <defName>MFV_ArcaneCache_Showcase</defName>
    <label>arcane cache showcase</label>
    <description>A debug-only oversized arcane cache that exposes all current modular site pieces.</description>
    <workerClass>MFVanilla.Core.SitePartWorker_ArcaneCache</workerClass>
    <siteTexture>World/WorldObjects/Sites/GenericSite</siteTexture>
    <expandingIconTexture>World/WorldObjects/Expanding/Sites/ItemStash</expandingIconTexture>
    <arrivedLetter>An oversized debug arcane cache showcase lies nearby.</arrivedLetter>
    <arrivedLetterDef>NeutralEvent</arrivedLetterDef>
    <wantsThreatPoints>true</wantsThreatPoints>
    <minThreatPoints>250</minThreatPoints>
    <handlesWorldObjectTimeoutInspectString>true</handlesWorldObjectTimeoutInspectString>
    <gravShipsCanLandOn>true</gravShipsCanLandOn>
    <tags>
      <li>MFV_ArcaneCache</li>
      <li>MFV_ArcaneCache_Showcase</li>
    </tags>
  </SitePartDef>

  <GenStepDef>
    <defName>MFV_ArcaneCache</defName>
    <linkWithSite>MFV_ArcaneCache</linkWithSite>
    <order>420</order>
    <genStep Class="MFVanilla.Core.GenStep_ArcaneCache">
      <profile>MFV_ArcaneCache_Default</profile>
      <profileEntries>
        <li>
          <profile>MFV_ArcaneCache_Default</profile>
          <weight>6</weight>
          <minThreatPoints>0</minThreatPoints>
        </li>
        <li>
          <profile>MFV_ArcaneCache_Ruined</profile>
          <weight>3</weight>
          <minThreatPoints>350</minThreatPoints>
        </li>
        <li>
          <profile>MFV_ArcaneCache_Sealed</profile>
          <weight>1</weight>
          <minThreatPoints>700</minThreatPoints>
        </li>
        <li>
          <profile>MFV_ArcaneCache_DeepIronVault</profile>
          <weight>0.35</weight>
          <minThreatPoints>1200</minThreatPoints>
        </li>
      </profileEntries>
    </genStep>
  </GenStepDef>

  <GenStepDef>
    <defName>MFV_ArcaneCache_Showcase</defName>
    <linkWithSite>MFV_ArcaneCache_Showcase</linkWithSite>
    <order>420</order>
    <genStep Class="MFVanilla.Core.GenStep_ArcaneCache">
