  <TerrainDef ParentName="WaterChestDeepBase">
    <defName>MFV_ManaRiverDeep</defName>
    <label>deep mana current</label>
    <description>A luminous stream of condensed planar mana. Its surface moves like water, but the current carries arcane charge instead of ordinary silt.</description>
    <texturePath>Terrain/Surfaces/WaterChestDeepRamp</texturePath>
    <waterDepthShader>Map/WaterDepth</waterDepthShader>
    <renderPrecedence>399</renderPrecedence>
    <color>(0.62,0.35,1)</color>
    <pathCost>42</pathCost>
    <affordances>
      <li>MovingFluid</li>
    </affordances>
    <tags>
      <li>River</li>
    </tags>
    <waterDepthShaderParameters>
      <_UseWaterOffset>1</_UseWaterOffset>
    </waterDepthShaderParameters>
  </TerrainDef>

