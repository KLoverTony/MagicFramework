<?xml version="1.0" encoding="utf-8" ?>
<Defs>

  <TerrainDef ParentName="NaturalTerrainBase">
    <defName>MFV_PlanarTileA</defName>
    <label>planar glass</label>
    <description>A smooth ground plane from a folded pocket of unstable space.</description>
    <texturePath>Things/Terrain/Planar/TileAlpha1</texturePath>
    <edgeType>FadeRough</edgeType>
    <categoryType>Soil</categoryType>
    <renderPrecedence>360</renderPrecedence>
    <pathCost>1</pathCost>
    <statBases>
      <Beauty>1</Beauty>
      <BeautyOutdoors>1</BeautyOutdoors>
      <Cleanliness>0</Cleanliness>
    </statBases>
    <affordances>
      <li>Light</li>
      <li>Medium</li>
      <li>Heavy</li>
      <li>GrowSoil</li>
    </affordances>
    <fertility>0.8</fertility>
  </TerrainDef>

  <TerrainDef ParentName="NaturalTerrainBase">
