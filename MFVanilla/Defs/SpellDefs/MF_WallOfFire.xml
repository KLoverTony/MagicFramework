<?xml version="1.0" encoding="utf-8" ?>
<Defs>
  <MagicFramework.Definitions.SpellDef>
    <defName>MF_WallOfFire</defName>
    <label>wall of fire</label>
    <description>Creates a persistent wall of magical flame that burns creatures standing too close.</description>
    <gizmoIconPath>UI/Gizmos/Spells/MF_WallOfFire</gizmoIconPath>
    <range>22</range>
    <castTimeTicks>60</castTimeTicks>

    <meta>
      <tier>2</tier>
      <elements>
        <li>MF_Element_Fire</li>
      </elements>
      <domains>
        <li>MF_Domain_Pyromancy</li>
        <li>MF_Domain_Warding</li>
      </domains>
      <disciplines>
        <li>MF_Discipline_Combat</li>
        <li>MF_Discipline_Warding</li>
      </disciplines>
      <tags>
        <li>MF_Tag_Area</li>
        <li>MF_Tag_Hostile</li>
        <li>MF_Tag_DirectDamage</li>
        <li>MF_Tag_WeatherSensitive</li>
      </tags>
    </meta>

    <learning>
      <canBeLearned>true</canBeLearned>
      <researchPrerequisites>
        <li>MFV_Pyromancy</li>
      </researchPrerequisites>
      <requirements>
        <li Class="MagicFramework.Definitions.ArcaneGiftRequirementDef" />
        <li Class="MagicFramework.Definitions.CasterLevelRequirementDef">
          <minimumLevel>3</minimumLevel>
        </li>
      </requirements>
    </learning>

    <targeting>
      <shape>Wall</shape>
      <primaryTargetType>Cell</primaryTargetType>
      <pawnAffinity>All</pawnAffinity>
      <includePawns>false</includePawns>
      <includeBuildings>false</includeBuildings>
      <includeItems>false</includeItems>
      <allowSelfTarget>false</allowSelfTarget>
      <requireLineOfSight>true</requireLineOfSight>
      <requireWalkableCell>true</requireWalkableCell>
      <range>22</range>
      <wallLength>5</wallLength>
    </targeting>

    <requirements>
      <li Class="MagicFramework.Definitions.ManaRequirementDef">
        <debugLabel>Enough mana for Wall of Fire</debugLabel>
        <amount>24</amount>
      </li>
      <li Class="MagicFramework.Definitions.CooldownRequirementDef">
        <debugLabel>Wall of Fire cooldown ready</debugLabel>
        <cooldownTicks>360</cooldownTicks>
      </li>
    </requirements>

    <costs>
      <li Class="MagicFramework.Definitions.ManaCostDef">
        <debugLabel>Spend mana for Wall of Fire</debugLabel>
        <amount>24</amount>
      </li>
      <li Class="MagicFramework.Definitions.CooldownCostDef">
        <debugLabel>Start Wall of Fire cooldown</debugLabel>
        <cooldownTicks>360</cooldownTicks>
      </li>
    </costs>

    <actions>
      <li Class="MagicFramework.Definitions.SequenceActionDef">
        <debugLabel>Wall of Fire sequence</debugLabel>
        <actions>
          <li Class="MagicFramework.Definitions.EffectActionDef">
            <debugLabel>Wall of Fire cast effect</debugLabel>
            <effectDef>Mote_SparkThrownFast</effectDef>
            <locationSource>Caster</locationSource>
            <attachToTarget>false</attachToTarget>
          </li>
          <li Class="MagicFramework.Definitions.PersistentWallZoneActionDef">
            <debugLabel>Wall of Fire persistent wall zone</debugLabel>
            <markerThingDef>MF_WallOfFireMarker</markerThingDef>
            <wallLength>5</wallLength>
            <pulseRadius>0.95</pulseRadius>
            <pulseIntervalTicks>60</pulseIntervalTicks>
            <durationTicks>900</durationTicks>
            <failsafeDurationTicks>1200</failsafeDurationTicks>
            <pawnAffinity>All</pawnAffinity>
            <includeCaster>false</includeCaster>
            <replaceExistingForCaster>true</replaceExistingForCaster>
            <actions>
              <li Class="MagicFramework.Definitions.EffectActionDef">
                <debugLabel>Wall of Fire pulse effect</debugLabel>
                <effectDef>Power_Cell_Sparks</effectDef>
                <locationSource>CurrentCell</locationSource>
                <attachToTarget>false</attachToTarget>
              </li>
              <li Class="MagicFramework.Definitions.DamageActionDef">
                <debugLabel>Wall of Fire damage</debugLabel>
                <amount>6</amount>
                <damageDef>Flame</damageDef>
              </li>
              <li Class="MagicFramework.Definitions.ApplyHediffActionDef">
                <debugLabel>Wall of Fire burn</debugLabel>
                <hediffDef>Burn</hediffDef>
                <severity>0.08</severity>
              </li>
            </actions>
          </li>
        </actions>
      </li>
    </actions>
  </MagicFramework.Definitions.SpellDef>
</Defs>
