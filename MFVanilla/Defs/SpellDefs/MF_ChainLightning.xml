<?xml version="1.0" encoding="utf-8" ?>
<Defs>
  <MagicFramework.Definitions.SpellDef>
    <defName>MF_ChainLightning</defName>
    <label>chain lightning</label>
    <description>Strikes a foe with arcing lightning that jumps forward through nearby enemies, sometimes stunning those it hits.</description>
    <range>22</range>
    <castTimeTicks>45</castTimeTicks>
    <gizmoIconPath>UI/Gizmos/Spells/MF_ChainLightning</gizmoIconPath>

    <meta>
      <tier>2</tier>
      <elements>
        <li>MF_Element_Lightning</li>
        <li>MF_Element_Air</li>
      </elements>
      <domains>
        <li>MF_Domain_Aeromancy</li>
      </domains>
      <disciplines>
        <li>MF_Discipline_Combat</li>
        <li>MF_Discipline_Control</li>
      </disciplines>
      <tags>
        <li>MF_Tag_Hostile</li>
        <li>MF_Tag_DirectDamage</li>
        <li>MF_Tag_Debuff</li>
        <li>MF_Tag_WeatherSensitive</li>
      </tags>
    </meta>

    <learning>
      <canBeLearned>true</canBeLearned>
      <researchPrerequisites>
        <li>MFV_Aeromancy</li>
      </researchPrerequisites>
      <requirements>
        <li Class="MagicFramework.Definitions.ArcaneGiftRequirementDef" />
        <li Class="MagicFramework.Definitions.CasterLevelRequirementDef">
          <minimumLevel>3</minimumLevel>
        </li>
      </requirements>
    </learning>

    <power>
      <casterLevelFactor>1</casterLevelFactor>
      <scaledAttributes>
        <li>Damage</li>
      </scaledAttributes>
    </power>

    <targeting>
      <shape>Single</shape>
      <primaryTargetType>Pawn</primaryTargetType>
      <pawnAffinity>Foe</pawnAffinity>
      <includePawns>true</includePawns>
      <includeBuildings>false</includeBuildings>
      <includeItems>false</includeItems>
      <allowSelfTarget>false</allowSelfTarget>
      <requireLineOfSight>true</requireLineOfSight>
      <range>22</range>
    </targeting>

    <requirements>
      <li Class="MagicFramework.Definitions.ManaRequirementDef">
        <debugLabel>Enough mana for Chain Lightning</debugLabel>
        <amount>24</amount>
      </li>
      <li Class="MagicFramework.Definitions.CooldownRequirementDef">
        <debugLabel>Chain Lightning cooldown ready</debugLabel>
        <cooldownTicks>420</cooldownTicks>
      </li>
    </requirements>

    <costs>
      <li Class="MagicFramework.Definitions.ManaCostDef">
        <debugLabel>Spend mana for Chain Lightning</debugLabel>
        <amount>24</amount>
      </li>
      <li Class="MagicFramework.Definitions.CooldownCostDef">
        <debugLabel>Start Chain Lightning cooldown</debugLabel>
        <cooldownTicks>420</cooldownTicks>
      </li>
    </costs>

    <actions>
      <li Class="MagicFramework.Definitions.ChainLightningActionDef">
        <debugLabel>Chain Lightning arcs</debugLabel>
        <jumpDelayTicks>10</jumpDelayTicks>
        <jumpRadius>7</jumpRadius>
        <maxHops>9</maxHops>
        <minBranches>1</minBranches>
        <maxBranches>2</maxBranches>
        <minForwardScore>-0.10</minForwardScore>
        <allowRepeatTargets>true</allowRepeatTargets>
        <includeCaster>false</includeCaster>
        <pawnAffinity>Foe</pawnAffinity>
        <impactFleckDef>SparkFlash</impactFleckDef>
        <lineFleckDef>ElectricalSpark</lineFleckDef>
        <stunFleckDef>Mote_Stun</stunFleckDef>
        <onHitActions>
          <li Class="MagicFramework.Definitions.DamageActionDef">
            <debugLabel>Chain Lightning shock damage</debugLabel>
            <amount>12</amount>
            <damageDef>Burn</damageDef>
            <armorPenetration>0.15</armorPenetration>
          </li>
          <li Class="MagicFramework.Definitions.StunActionDef">
            <debugLabel>Chain Lightning stun chance</debugLabel>
            <chance>0.30</chance>
            <stunTicks>90</stunTicks>
            <fleckDef>Mote_Stun</fleckDef>
          </li>
        </onHitActions>
      </li>
    </actions>
  </MagicFramework.Definitions.SpellDef>
</Defs>
