<?xml version="1.0" encoding="utf-8" ?>
<Defs>
  <MagicFramework.Definitions.SpellDef>
    <defName>MF_TemporalResurrection</defName>
    <label>temporal resurrection</label>
    <description>Snaps a dead humanlike pawn back through time, restoring life and slowly reversing wounds. The recovered pawn remains comatose during the reconstruction and loses skill memory in proportion to their former abilities. Higher caster level reduces, but never removes, the loss.</description>
    <gizmoIconPath>UI/Gizmos/Spells/MF_ChronoResurrection</gizmoIconPath>
    <range>8</range>
    <castTimeTicks>240</castTimeTicks>

    <meta>
      <tier>4</tier>
      <elements>
        <li>MF_Element_Time</li>
        <li>MF_Element_Life</li>
        <li>MF_Element_Spirit</li>
      </elements>
      <domains>
        <li>MF_Domain_Chronomancy</li>
      </domains>
      <disciplines>
        <li>MF_Discipline_Ritual</li>
        <li>MF_Discipline_Healing</li>
      </disciplines>
      <tags>
        <li>MF_Tag_Beneficial</li>
        <li>MF_Tag_CorpseRequired</li>
        <li>MF_Tag_RitualSpell</li>
        <li>MF_Tag_Debuff</li>
      </tags>
    </meta>

    <learning>
      <canBeLearned>true</canBeLearned>
      <researchPrerequisites>
        <li>MFV_Chronomancy</li>
      </researchPrerequisites>
      <requirements>
        <li Class="MagicFramework.Definitions.ArcaneGiftRequirementDef" />
        <li Class="MagicFramework.Definitions.CasterLevelRequirementDef">
          <minimumLevel>10</minimumLevel>
        </li>
      </requirements>
    </learning>

    <power>
      <casterLevelFactor>1</casterLevelFactor>
    </power>

    <targeting>
      <shape>Single</shape>
      <primaryTargetType>Thing</primaryTargetType>
      <pawnAffinity>Ally</pawnAffinity>
      <includePawns>false</includePawns>
      <includeBuildings>false</includeBuildings>
      <includeItems>true</includeItems>
      <allowSelfTarget>false</allowSelfTarget>
      <requireLineOfSight>true</requireLineOfSight>
      <requireResurrectableCorpse>true</requireResurrectableCorpse>
      <range>8</range>
    </targeting>

    <requirements>
      <li Class="MagicFramework.Definitions.ManaRequirementDef">
        <debugLabel>Enough mana for Temporal Resurrection</debugLabel>
        <amount>75</amount>
      </li>
      <li Class="MagicFramework.Definitions.CooldownRequirementDef">
        <debugLabel>Temporal Resurrection cooldown ready</debugLabel>
        <cooldownTicks>60000</cooldownTicks>
      </li>
    </requirements>

    <costs>
      <li Class="MagicFramework.Definitions.ManaCostDef">
        <debugLabel>Spend mana for Temporal Resurrection</debugLabel>
        <amount>75</amount>
      </li>
      <li Class="MagicFramework.Definitions.CooldownCostDef">
        <debugLabel>Start Temporal Resurrection cooldown</debugLabel>
        <cooldownTicks>60000</cooldownTicks>
      </li>
    </costs>

    <actions>
      <li Class="MagicFramework.Definitions.SequenceActionDef">
        <debugLabel>Temporal resurrection sequence</debugLabel>
        <actions>
          <li Class="MagicFramework.Definitions.EffectActionDef">
            <debugLabel>Temporal resurrection opening flare</debugLabel>
            <effectDef>Skip_EntryNoDelay</effectDef>
            <soundDef>Resurrect_Cast</soundDef>
            <locationSource>CurrentTarget</locationSource>
            <attachToTarget>true</attachToTarget>
          </li>
          <li Class="MFVanilla.Core.TemporalResurrectionActionDef">
            <debugLabel>Restore life and begin temporal reconstruction</debugLabel>
            <hediffDef>MF_TemporalReconstruction</hediffDef>
            <baseSkillLossFraction>0.24</baseSkillLossFraction>
            <skillLossReductionPerCasterLevel>0.007</skillLossReductionPerCasterLevel>
            <minSkillLossFraction>0.06</minSkillLossFraction>
            <pulseIntervalTicks>90</pulseIntervalTicks>
            <healingPerPulse>4</healingPerPulse>
          </li>
          <li Class="MagicFramework.Definitions.EffectActionDef">
            <debugLabel>Temporal resurrection resolve burst</debugLabel>
            <effectDef>Skip_ExitNoDelay</effectDef>
            <soundDef>Resurrect_Resolve</soundDef>
            <locationSource>CurrentTarget</locationSource>
            <attachToTarget>true</attachToTarget>
          </li>
          <li Class="MagicFramework.Definitions.EffectActionDef">
            <debugLabel>Temporal reconstruction time shimmer</debugLabel>
            <effectDef>PsychicApplyNeuroquake</effectDef>
            <locationSource>CurrentTarget</locationSource>
            <attachToTarget>true</attachToTarget>
          </li>
        </actions>
      </li>
    </actions>
  </MagicFramework.Definitions.SpellDef>
</Defs>
