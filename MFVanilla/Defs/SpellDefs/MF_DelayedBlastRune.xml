<?xml version="1.0" encoding="utf-8" ?>
<Defs>
  <MagicFramework.Definitions.SpellDef>
    <defName>MF_DelayedBlastRune</defName>
    <label>delayed blast rune</label>
    <description>Places a glowing magical rune on a target cell, then detonates after a short delay.</description>
    <gizmoIconPath>UI/Gizmos/Spells/MF_DelayedBlastRune</gizmoIconPath>
    <range>20</range>
    <castTimeTicks>45</castTimeTicks>

    <targeting>
      <shape>Single</shape>
      <primaryTargetType>Cell</primaryTargetType>
      <pawnAffinity>All</pawnAffinity>
      <includePawns>false</includePawns>
      <includeBuildings>false</includeBuildings>
      <includeItems>false</includeItems>
      <allowSelfTarget>false</allowSelfTarget>
      <requireLineOfSight>true</requireLineOfSight>
      <requireWalkableCell>true</requireWalkableCell>
      <range>20</range>
    </targeting>

    <requirements>
      <li Class="MagicFramework.Definitions.ManaRequirementDef">
        <debugLabel>Enough mana for Delayed Blast Rune</debugLabel>
        <amount>16</amount>
      </li>
      <li Class="MagicFramework.Definitions.CooldownRequirementDef">
        <debugLabel>Delayed Blast Rune cooldown ready</debugLabel>
        <cooldownTicks>240</cooldownTicks>
      </li>
    </requirements>

    <costs>
      <li Class="MagicFramework.Definitions.ManaCostDef">
        <debugLabel>Spend mana for Delayed Blast Rune</debugLabel>
        <amount>16</amount>
      </li>
      <li Class="MagicFramework.Definitions.CooldownCostDef">
        <debugLabel>Start Delayed Blast Rune cooldown</debugLabel>
        <cooldownTicks>240</cooldownTicks>
      </li>
    </costs>

    <actions>
      <li Class="MagicFramework.Definitions.SequenceActionDef">
        <debugLabel>Delayed Blast Rune sequence</debugLabel>
        <actions>
          <li Class="MagicFramework.Definitions.EffectActionDef">
            <debugLabel>Delayed Blast Rune placement effect</debugLabel>
            <effectDef>Power_Cell_Sparks</effectDef>
            <locationSource>CurrentCell</locationSource>
            <attachToTarget>false</attachToTarget>
          </li>
          <li Class="MagicFramework.Definitions.DelayActionDef">
            <debugLabel>Delayed Blast Rune fuse</debugLabel>
            <delayTicks>180</delayTicks>
            <actions>
              <li Class="MagicFramework.Definitions.EffectActionDef">
                <debugLabel>Delayed Blast Rune detonation effect</debugLabel>
                <effectDef>GiantExplosion</effectDef>
                <soundDef>Explosion_Flame</soundDef>
                <locationSource>CurrentCell</locationSource>
                <attachToTarget>false</attachToTarget>
              </li>
              <li Class="MagicFramework.Definitions.ExplosionActionDef">
                <debugLabel>Delayed Blast Rune explosion</debugLabel>
                <radius>2.9</radius>
                <damageAmount>18</damageAmount>
              </li>
            </actions>
          </li>
        </actions>
      </li>
    </actions>
  </MagicFramework.Definitions.SpellDef>
</Defs>
