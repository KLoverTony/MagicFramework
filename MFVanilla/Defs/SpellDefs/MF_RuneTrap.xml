<?xml version="1.0" encoding="utf-8" ?>
<Defs>
  <MagicFramework.Definitions.SpellDef>
    <defName>MF_RuneTrap</defName>
    <label>rune trap</label>
    <description>Places an armed rune that waits for a hostile pawn to enter range before detonating.</description>
    <gizmoIconPath>UI/Gizmos/Spells/MF_RuneTrap</gizmoIconPath>
    <range>20</range>
    <castTimeTicks>45</castTimeTicks>

    <meta>
      <tier>2</tier>
      <elements>
        <li>MF_Element_Arcane</li>
        <li>MF_Element_Fire</li>
      </elements>
      <domains>
        <li>MF_Domain_Warding</li>
        <li>MF_Domain_Pyromancy</li>
      </domains>
      <disciplines>
        <li>MF_Discipline_Ritual</li>
        <li>MF_Discipline_Warding</li>
        <li>MF_Discipline_Combat</li>
      </disciplines>
      <tags>
        <li>MF_Tag_Area</li>
        <li>MF_Tag_Hostile</li>
        <li>MF_Tag_RitualSpell</li>
        <li>MF_Tag_WeatherSensitive</li>
      </tags>
    </meta>

    <learning>
      <canBeLearned>true</canBeLearned>
      <researchPrerequisites>
        <li>MFV_RunicInscription</li>
      </researchPrerequisites>
      <requirements>
        <li Class="MagicFramework.Definitions.ArcaneGiftRequirementDef" />
        <li Class="MagicFramework.Definitions.CasterLevelRequirementDef">
          <minimumLevel>3</minimumLevel>
        </li>
      </requirements>
    </learning>

    <power>
      <casterLevelFactor>1</casterLevelFactor>
      <scaledAttributes>
        <li>Damage</li>
        <li>Radius</li>
      </scaledAttributes>
    </power>

    <targeting>
      <shape>Single</shape>
      <primaryTargetType>Cell</primaryTargetType>
      <pawnAffinity>All</pawnAffinity>
      <includePawns>false</includePawns>
      <includeBuildings>false</includeBuildings>
      <includeItems>false</includeItems>
      <allowSelfTarget>false</allowSelfTarget>
      <requireLineOfSight>true</requireLineOfSight>
      <requireWalkableCell>true</requireWalkableCell>
      <range>20</range>
    </targeting>

    <requirements>
      <li Class="MagicFramework.Definitions.ManaRequirementDef">
        <debugLabel>Enough mana for Rune Trap</debugLabel>
        <amount>14</amount>
      </li>
      <li Class="MagicFramework.Definitions.CooldownRequirementDef">
        <debugLabel>Rune Trap cooldown ready</debugLabel>
        <cooldownTicks>180</cooldownTicks>
      </li>
    </requirements>

    <costs>
      <li Class="MagicFramework.Definitions.ManaCostDef">
        <debugLabel>Spend mana for Rune Trap</debugLabel>
        <amount>14</amount>
      </li>
      <li Class="MagicFramework.Definitions.CooldownCostDef">
        <debugLabel>Start Rune Trap cooldown</debugLabel>
        <cooldownTicks>180</cooldownTicks>
      </li>
    </costs>

    <actions>
      <li Class="MagicFramework.Definitions.SequenceActionDef">
        <debugLabel>Rune Trap sequence</debugLabel>
        <actions>
          <li Class="MagicFramework.Definitions.EffectActionDef">
            <debugLabel>Rune Trap placement effect</debugLabel>
            <effectDef>Power_Cell_Sparks</effectDef>
            <locationSource>CurrentCell</locationSource>
            <attachToTarget>false</attachToTarget>
          </li>
          <li Class="MagicFramework.Definitions.PersistentEffectActionDef">
            <debugLabel>Rune Trap persistent marker</debugLabel>
            <markerThingDef>MF_RuneTrapMarker</markerThingDef>
            <durationTicks>-1</durationTicks>
            <failsafeDurationTicks>3600</failsafeDurationTicks>
            <replaceExistingForCaster>true</replaceExistingForCaster>
          </li>
          <li Class="MagicFramework.Definitions.ProximityTriggerActionDef">
            <debugLabel>Rune Trap armed trigger</debugLabel>
            <triggerRadius>1.9</triggerRadius>
            <pawnAffinity>Foe</pawnAffinity>
            <includeCaster>false</includeCaster>
            <replaceExistingForCaster>true</replaceExistingForCaster>
            <removePersistentEffectsForCasterSpell>true</removePersistentEffectsForCasterSpell>
            <checkIntervalTicks>15</checkIntervalTicks>
            <actions>
              <li Class="MagicFramework.Definitions.EffectActionDef">
                <debugLabel>Rune Trap detonation effect</debugLabel>
                <effectDef>GiantExplosion</effectDef>
                <soundDef>Explosion_Flame</soundDef>
                <locationSource>CurrentCell</locationSource>
                <attachToTarget>false</attachToTarget>
              </li>
              <li Class="MagicFramework.Definitions.ExplosionActionDef">
                <debugLabel>Rune Trap explosion</debugLabel>
                <radius>2.4</radius>
                <damageAmount>16</damageAmount>
              </li>
            </actions>
          </li>
        </actions>
      </li>
    </actions>
  </MagicFramework.Definitions.SpellDef>
</Defs>
