<?xml version="1.0" encoding="utf-8" ?>
<Defs>
  <MagicFramework.Definitions.SpellDef>
    <defName>MF_Fireball</defName>
    <label>fireball</label>
    <description>A fiery explosive spell that detonates at the chosen point and burns creatures nearby.</description>
    <range>28</range>
    <castTimeTicks>60</castTimeTicks>
    <gizmoIconPath>UI/Gizmos/Spells/MF_Fireball</gizmoIconPath>

    <meta>
      <tier>2</tier>
      <elements>
        <li>MF_Element_Fire</li>
      </elements>
      <domains>
        <li>MF_Domain_Pyromancy</li>
      </domains>
      <disciplines>
        <li>MF_Discipline_Combat</li>
      </disciplines>
      <tags>
        <li>MF_Tag_Area</li>
        <li>MF_Tag_Hostile</li>
        <li>MF_Tag_DirectDamage</li>
        <li>MF_Tag_WeatherSensitive</li>
      </tags>
    </meta>

    <learning>
      <canBeLearned>true</canBeLearned>
      <researchPrerequisites>
        <li>MFV_Pyromancy</li>
      </researchPrerequisites>
      <requirements>
        <li Class="MagicFramework.Definitions.ArcaneGiftRequirementDef" />
        <li Class="MagicFramework.Definitions.CasterLevelRequirementDef">
          <minimumLevel>3</minimumLevel>
        </li>
      </requirements>
    </learning>

    <targeting>
      <shape>Radius</shape>
      <primaryTargetType>PawnOrCell</primaryTargetType>
      <pawnAffinity>All</pawnAffinity>
      <includePawns>true</includePawns>
      <includeBuildings>false</includeBuildings>
      <includeItems>false</includeItems>
      <allowSelfTarget>false</allowSelfTarget>
      <requireLineOfSight>true</requireLineOfSight>
      <range>28</range>
      <radius>3.9</radius>
    </targeting>

    <requirements>
      <li Class="MagicFramework.Definitions.ManaRequirementDef">
        <debugLabel>Enough mana for Fireball</debugLabel>
        <amount>20</amount>
      </li>
      <li Class="MagicFramework.Definitions.CooldownRequirementDef">
        <debugLabel>Fireball cooldown ready</debugLabel>
        <cooldownTicks>300</cooldownTicks>
      </li>
    </requirements>

    <costs>
      <li Class="MagicFramework.Definitions.ManaCostDef">
        <debugLabel>Spend mana for Fireball</debugLabel>
        <amount>20</amount>
      </li>
      <li Class="MagicFramework.Definitions.CooldownCostDef">
        <debugLabel>Start Fireball cooldown</debugLabel>
        <cooldownTicks>300</cooldownTicks>
      </li>
    </costs>

    <actions>
      <li Class="MagicFramework.Definitions.SequenceActionDef">
        <debugLabel>Fireball sequence</debugLabel>
        <actions>
          <li Class="MagicFramework.Definitions.EffectActionDef">
            <debugLabel>Fireball cast effect</debugLabel>
            <effectDef>Mote_SparkThrownFast</effectDef>
            <locationSource>Caster</locationSource>
            <attachToTarget>false</attachToTarget>
          </li>
          <li Class="MagicFramework.Definitions.LaunchProjectileActionDef">
            <debugLabel>Fireball projectile</debugLabel>
            <projectileDef>Bullet_IncendiaryLauncher</projectileDef>
            <onImpactActions>
              <li Class="MagicFramework.Definitions.EffectActionDef">
                <debugLabel>Fireball impact effect</debugLabel>
                <effectDef>GiantExplosion</effectDef>
                <soundDef>Explosion_Flame</soundDef>
                <locationSource>CurrentCell</locationSource>
                <attachToTarget>false</attachToTarget>
              </li>
              <li Class="MagicFramework.Definitions.ExplosionActionDef">
                <debugLabel>Fireball explosion</debugLabel>
                <radius>3.9</radius>
                <damageAmount>14</damageAmount>
              </li>
              <li Class="MagicFramework.Definitions.ApplyToTargetsActionDef">
                <debugLabel>Apply burning effects in blast radius</debugLabel>
                <targetQuery Class="MagicFramework.Definitions.TargetsInRadiusQueryDef">
                  <debugLabel>Targets around fireball impact</debugLabel>
                  <radius>3.9</radius>
                  <centerSource>CurrentCell</centerSource>
                  <includePawns>true</includePawns>
                  <includeBuildings>false</includeBuildings>
                  <includeItems>false</includeItems>
                  <includeCaster>false</includeCaster>
                  <pawnAffinity>All</pawnAffinity>
                </targetQuery>
                <actions>
                  <li Class="MagicFramework.Definitions.DamageActionDef">
                    <debugLabel>Secondary fire damage</debugLabel>
                    <amount>10</amount>
                    <damageDef>Flame</damageDef>
                  </li>
                  <li Class="MagicFramework.Definitions.ApplyHediffActionDef">
                    <debugLabel>Apply burn injury</debugLabel>
                    <hediffDef>Burn</hediffDef>
                    <severity>0.20</severity>
                  </li>
                </actions>
              </li>
            </onImpactActions>
          </li>
        </actions>
      </li>
    </actions>
  </MagicFramework.Definitions.SpellDef>
</Defs>
