<?xml version="1.0" encoding="utf-8" ?>
<Defs>
  <MagicFramework.Definitions.SpellDef>
    <defName>MF_ArcSeeker</defName>
    <label>arc seeker</label>
    <description>Releases unstable lightning from the caster that leaps to the nearest hostile pawn nearby.</description>
    <gizmoIconPath>UI/Gizmos/Spells/MF_ArcSeeker</gizmoIconPath>
    <range>20</range>
    <castTimeTicks>35</castTimeTicks>

    <meta>
      <tier>1</tier>
      <elements>
        <li>MF_Element_Lightning</li>
        <li>MF_Element_Air</li>
      </elements>
      <domains>
        <li>MF_Domain_Aeromancy</li>
      </domains>
      <disciplines>
        <li>MF_Discipline_Combat</li>
        <li>MF_Discipline_Control</li>
      </disciplines>
      <tags>
        <li>MF_Tag_Hostile</li>
        <li>MF_Tag_DirectDamage</li>
        <li>MF_Tag_Debuff</li>
        <li>MF_Tag_WeatherSensitive</li>
      </tags>
    </meta>

    <learning>
      <canBeLearned>true</canBeLearned>
      <researchPrerequisites>
        <li>MFV_Aeromancy</li>
      </researchPrerequisites>
      <requirements>
        <li Class="MagicFramework.Definitions.ArcaneGiftRequirementDef" />
        <li Class="MagicFramework.Definitions.CasterLevelRequirementDef">
          <minimumLevel>1</minimumLevel>
        </li>
      </requirements>
    </learning>

    <targeting>
      <shape>Single</shape>
      <primaryTargetType>Pawn</primaryTargetType>
      <pawnAffinity>All</pawnAffinity>
      <includePawns>true</includePawns>
      <includeBuildings>false</includeBuildings>
      <includeItems>false</includeItems>
      <allowSelfTarget>true</allowSelfTarget>
      <useCasterAsTarget>true</useCasterAsTarget>
      <requireLineOfSight>false</requireLineOfSight>
      <range>0</range>
    </targeting>

    <requirements>
      <li Class="MagicFramework.Definitions.ManaRequirementDef">
        <debugLabel>Enough mana for Arc Seeker</debugLabel>
        <amount>12</amount>
      </li>
      <li Class="MagicFramework.Definitions.CooldownRequirementDef">
        <debugLabel>Arc Seeker cooldown ready</debugLabel>
        <cooldownTicks>150</cooldownTicks>
      </li>
    </requirements>

    <costs>
      <li Class="MagicFramework.Definitions.ManaCostDef">
        <debugLabel>Spend mana for Arc Seeker</debugLabel>
        <amount>12</amount>
      </li>
      <li Class="MagicFramework.Definitions.CooldownCostDef">
        <debugLabel>Start Arc Seeker cooldown</debugLabel>
        <cooldownTicks>150</cooldownTicks>
      </li>
    </costs>

    <actions>
      <li Class="MagicFramework.Definitions.SequenceActionDef">
        <debugLabel>Arc Seeker sequence</debugLabel>
        <actions>
          <li Class="MagicFramework.Definitions.ApplyToTargetsActionDef">
            <debugLabel>Arc Seeker nearest foe query</debugLabel>
            <targetQuery Class="MagicFramework.Definitions.NearestValidTargetQueryDef">
              <debugLabel>Nearest hostile near marked cell</debugLabel>
              <maxRadius>7</maxRadius>
              <includePawns>true</includePawns>
              <includeBuildings>false</includeBuildings>
              <includeItems>false</includeItems>
              <includeCaster>false</includeCaster>
              <pawnAffinity>Foe</pawnAffinity>
            </targetQuery>
            <actions>
              <li Class="MagicFramework.Definitions.ChainLightningActionDef">
                <debugLabel>Arc Seeker lightning strike</debugLabel>
                <jumpDelayTicks>1</jumpDelayTicks>
                <jumpRadius>0</jumpRadius>
                <maxHops>0</maxHops>
                <minBranches>1</minBranches>
                <maxBranches>1</maxBranches>
                <allowRepeatTargets>false</allowRepeatTargets>
                <includeCaster>false</includeCaster>
                <pawnAffinity>Foe</pawnAffinity>
                <impactFleckDef>SparkFlash</impactFleckDef>
                <lineFleckDef>ElectricalSpark</lineFleckDef>
                <stunFleckDef>Mote_Stun</stunFleckDef>
                <onHitActions>
                  <li Class="MagicFramework.Definitions.DamageActionDef">
                    <debugLabel>Arc Seeker shock damage</debugLabel>
                    <amount>14</amount>
                    <damageDef>Burn</damageDef>
                    <armorPenetration>0.10</armorPenetration>
                  </li>
                  <li Class="MagicFramework.Definitions.StunActionDef">
                    <debugLabel>Arc Seeker brief stun</debugLabel>
                    <chance>0.35</chance>
                    <stunTicks>60</stunTicks>
                    <fleckDef>Mote_Stun</fleckDef>
                  </li>
                </onHitActions>
              </li>
            </actions>
          </li>
        </actions>
      </li>
    </actions>
  </MagicFramework.Definitions.SpellDef>
</Defs>
