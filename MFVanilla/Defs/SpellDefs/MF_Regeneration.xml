<?xml version="1.0" encoding="utf-8" ?>
<Defs>
  <MagicFramework.Definitions.SpellDef>
    <defName>MF_Regeneration</defName>
    <label>regeneration</label>
    <description>Restores an allied pawn gradually, sending repeated healing pulses through their wounds.</description>
    <gizmoIconPath>UI/Gizmos/Spells/MF_Regeneration</gizmoIconPath>
    <range>16</range>
    <castTimeTicks>35</castTimeTicks>

    <meta>
      <tier>2</tier>
      <elements>
        <li>MF_Element_Life</li>
      </elements>
      <domains>
        <li>MF_Domain_Vitalism</li>
      </domains>
      <disciplines>
        <li>MF_Discipline_Healing</li>
      </disciplines>
      <tags>
        <li>MF_Tag_Beneficial</li>
        <li>MF_Tag_Buff</li>
      </tags>
    </meta>

    <learning>
      <canBeLearned>true</canBeLearned>
      <researchPrerequisites>
        <li>MFV_Vitalism</li>
      </researchPrerequisites>
      <requirements>
        <li Class="MagicFramework.Definitions.ArcaneGiftRequirementDef" />
        <li Class="MagicFramework.Definitions.CasterLevelRequirementDef">
          <minimumLevel>3</minimumLevel>
        </li>
      </requirements>
    </learning>

    <targeting>
      <shape>Single</shape>
      <primaryTargetType>Pawn</primaryTargetType>
      <pawnAffinity>Ally</pawnAffinity>
      <includePawns>true</includePawns>
      <includeBuildings>false</includeBuildings>
      <includeItems>false</includeItems>
      <allowSelfTarget>true</allowSelfTarget>
      <requireLineOfSight>true</requireLineOfSight>
      <range>16</range>
    </targeting>

    <requirements>
      <li Class="MagicFramework.Definitions.ManaRequirementDef">
        <debugLabel>Enough mana for Regeneration</debugLabel>
        <amount>14</amount>
      </li>
      <li Class="MagicFramework.Definitions.CooldownRequirementDef">
        <debugLabel>Regeneration cooldown ready</debugLabel>
        <cooldownTicks>300</cooldownTicks>
      </li>
    </requirements>

    <costs>
      <li Class="MagicFramework.Definitions.ManaCostDef">
        <debugLabel>Spend mana for Regeneration</debugLabel>
        <amount>14</amount>
      </li>
      <li Class="MagicFramework.Definitions.CooldownCostDef">
        <debugLabel>Start Regeneration cooldown</debugLabel>
        <cooldownTicks>300</cooldownTicks>
      </li>
    </costs>

    <actions>
      <li Class="MagicFramework.Definitions.SequenceActionDef">
        <debugLabel>Regeneration sequence</debugLabel>
        <actions>
          <li Class="MagicFramework.Definitions.EffectActionDef">
            <debugLabel>Regeneration initial effect</debugLabel>
            <effectDef>PsycastPsychicEffect</effectDef>
            <locationSource>CurrentTarget</locationSource>
            <attachToTarget>true</attachToTarget>
          </li>
          <li Class="MagicFramework.Definitions.RepeatActionDef">
            <debugLabel>Regeneration healing pulses</debugLabel>
            <intervalTicks>120</intervalTicks>
            <repeatCount>6</repeatCount>
            <includeImmediate>true</includeImmediate>
            <actions>
              <li Class="MagicFramework.Definitions.EffectActionDef">
                <debugLabel>Regeneration pulse effect</debugLabel>
                <effectDef>PsycastPsychicEffect</effectDef>
                <locationSource>CurrentTarget</locationSource>
                <attachToTarget>true</attachToTarget>
              </li>
              <li Class="MagicFramework.Definitions.HealActionDef">
                <debugLabel>Regeneration pulse heal</debugLabel>
                <amount>4</amount>
              </li>
            </actions>
          </li>
        </actions>
      </li>
    </actions>
  </MagicFramework.Definitions.SpellDef>
</Defs>
