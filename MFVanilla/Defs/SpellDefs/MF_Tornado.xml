<?xml version="1.0" encoding="utf-8" ?>
<Defs>
  <MagicFramework.Definitions.SpellDef>
    <defName>MF_Tornado</defName>
    <label>Tornado</label>
    <description>A magical new spell.</description>
    <range>24</range>
    <castTimeTicks>30</castTimeTicks>
    <gizmoIconPath>UI/Gizmos/Spells/MF_Tornado</gizmoIconPath>

    <meta>
      <tier>1</tier>
      <elements>
        <li>MF_Element_Air</li>
      </elements>
      <domains>
        <li>MF_Domain_Aeromancy</li>
      </domains>
      <disciplines>
        <li>MF_Discipline_Combat</li>
        <li>MF_Discipline_Control</li>
      </disciplines>
      <tags>
        <li>MF_Tag_Hostile</li>
        <li>MF_Tag_DirectDamage</li>
        <li>MF_Tag_Debuff</li>
      </tags>
    </meta>

    <learning>
      <canBeLearned>true</canBeLearned>
      <researchPrerequisites>
        <li>MFV_Aeromancy</li>
      </researchPrerequisites>
      <requirements>
        <li Class="MagicFramework.Definitions.ArcaneGiftRequirementDef" />
        <li Class="MagicFramework.Definitions.CasterLevelRequirementDef">
          <minimumLevel>1</minimumLevel>
        </li>
      </requirements>
    </learning>

    <targeting>
      <shape>Single</shape>
      <primaryTargetType>PawnOrCell</primaryTargetType>
      <pawnAffinity>All</pawnAffinity>
      <includePawns>true</includePawns>
      <includeBuildings>false</includeBuildings>
      <includeItems>false</includeItems>
      <allowSelfTarget>false</allowSelfTarget>
      <requireLineOfSight>true</requireLineOfSight>
      <range>24</range>
    </targeting>

    <requirements>
      <li Class="MagicFramework.Definitions.ManaRequirementDef">
        <debugLabel>Enough mana for Tornado</debugLabel>
        <amount>10</amount>
      </li>
      <li Class="MagicFramework.Definitions.CooldownRequirementDef">
        <debugLabel>Tornado cooldown ready</debugLabel>
        <cooldownTicks>120</cooldownTicks>
      </li>
    </requirements>

    <costs>
      <li Class="MagicFramework.Definitions.ManaCostDef">
        <debugLabel>Spend mana for Tornado</debugLabel>
        <amount>10</amount>
      </li>
      <li Class="MagicFramework.Definitions.CooldownCostDef">
        <debugLabel>Start Tornado cooldown</debugLabel>
        <cooldownTicks>120</cooldownTicks>
      </li>
    </costs>

    <actions>
      <li Class="MagicFramework.Definitions.SequenceActionDef">
        <debugLabel>Tornado sequence</debugLabel>
        <actions>
          <li Class="MagicFramework.Definitions.PersistentAreaZoneActionDef">
            <debugLabel>Create Tornado persistent zone</debugLabel>
            <markerThingDef>MF_FlameFieldMarker</markerThingDef>
            <zoneRadius>3</zoneRadius>
            <pulseIntervalTicks>60</pulseIntervalTicks>
            <durationTicks>600</durationTicks>
            <pulseAtCenter>false</pulseAtCenter>
            <pawnAffinity>All</pawnAffinity>
            <includeCaster>false</includeCaster>
            <replaceExistingForCaster>true</replaceExistingForCaster>
            <onPulseActions>
              <li Class="MagicFramework.Definitions.EffectActionDef">
                <debugLabel>Play Tornado effect</debugLabel>
                <effectDef>PsycastAreaEffect</effectDef>
                <locationSource>CurrentCell</locationSource>
                <attachToTarget>false</attachToTarget>
              </li>
            </onPulseActions>
            <actions>
              <li Class="MagicFramework.Definitions.DamageActionDef">
                <debugLabel>Apply Tornado damage</debugLabel>
                <amount>10</amount>
                <damageDef>Blunt</damageDef>
              </li>
              <li Class="MagicFramework.Definitions.KnockbackActionDef">
                <debugLabel>Apply Tornado knockback</debugLabel>
                <distance>1</distance>
              </li>
            </actions>
          </li>
        </actions>
      </li>
    </actions>
  </MagicFramework.Definitions.SpellDef>
</Defs>
