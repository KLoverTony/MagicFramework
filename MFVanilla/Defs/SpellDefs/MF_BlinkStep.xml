<?xml version="1.0" encoding="utf-8" ?>
<Defs>
  <MagicFramework.Definitions.SpellDef>
    <defName>MF_BlinkStep</defName>
    <label>blink step</label>
    <description>Instantly teleports the caster to a visible nearby cell.</description>
    <gizmoIconPath>UI/Gizmos/Spells/MF_BlinkStep</gizmoIconPath>
    <range>14</range>
    <castTimeTicks>20</castTimeTicks>

    <meta>
      <tier>1</tier>
      <elements>
        <li>MF_Element_Arcane</li>
      </elements>
      <domains>
        <li>MF_Domain_Transformation</li>
      </domains>
      <disciplines>
        <li>MF_Discipline_Movement</li>
        <li>MF_Discipline_Utility</li>
      </disciplines>
      <tags>
        <li>MF_Tag_Self</li>
        <li>MF_Tag_Beneficial</li>
      </tags>
    </meta>

    <learning>
      <canBeLearned>true</canBeLearned>
      <researchPrerequisites>
        <li>MFV_Transformation</li>
      </researchPrerequisites>
      <requirements>
        <li Class="MagicFramework.Definitions.ArcaneGiftRequirementDef" />
        <li Class="MagicFramework.Definitions.CasterLevelRequirementDef">
          <minimumLevel>1</minimumLevel>
        </li>
      </requirements>
    </learning>

    <targeting>
      <shape>Single</shape>
      <primaryTargetType>Cell</primaryTargetType>
      <pawnAffinity>All</pawnAffinity>
      <includePawns>false</includePawns>
      <includeBuildings>false</includeBuildings>
      <includeItems>false</includeItems>
      <allowSelfTarget>true</allowSelfTarget>
      <requireLineOfSight>true</requireLineOfSight>
      <requireWalkableCell>true</requireWalkableCell>
      <requireStandableCell>true</requireStandableCell>
      <range>14</range>
    </targeting>

    <requirements>
      <li Class="MagicFramework.Definitions.ManaRequirementDef">
        <debugLabel>Enough mana for Blink Step</debugLabel>
        <amount>12</amount>
      </li>
      <li Class="MagicFramework.Definitions.CooldownRequirementDef">
        <debugLabel>Blink Step cooldown ready</debugLabel>
        <cooldownTicks>150</cooldownTicks>
      </li>
    </requirements>

    <costs>
      <li Class="MagicFramework.Definitions.ManaCostDef">
        <debugLabel>Spend mana for Blink Step</debugLabel>
        <amount>12</amount>
      </li>
      <li Class="MagicFramework.Definitions.CooldownCostDef">
        <debugLabel>Start Blink Step cooldown</debugLabel>
        <cooldownTicks>150</cooldownTicks>
      </li>
    </costs>

    <actions>
      <li Class="MagicFramework.Definitions.SequenceActionDef">
        <debugLabel>Blink Step sequence</debugLabel>
        <actions>
          <li Class="MagicFramework.Definitions.EffectActionDef">
            <debugLabel>Blink Step departure</debugLabel>
            <effectDef>PsycastAreaEffect</effectDef>
            <locationSource>Caster</locationSource>
            <attachToTarget>false</attachToTarget>
          </li>
          <li Class="MagicFramework.Definitions.TeleportActionDef">
            <debugLabel>Blink Step teleport</debugLabel>
            <subjectSource>Caster</subjectSource>
            <destinationSource>CurrentCell</destinationSource>
            <requireStandableDestination>true</requireStandableDestination>
            <requireWalkableDestination>true</requireWalkableDestination>
            <allowTeleportOntoCaster>true</allowTeleportOntoCaster>
            <preserveDrafted>true</preserveDrafted>
            <postTeleportStunTicks>30</postTeleportStunTicks>
          </li>
          <li Class="MagicFramework.Definitions.EffectActionDef">
            <debugLabel>Blink Step arrival</debugLabel>
            <effectDef>PsycastPsychicEffect</effectDef>
            <locationSource>Caster</locationSource>
            <attachToTarget>true</attachToTarget>
          </li>
        </actions>
      </li>
    </actions>
  </MagicFramework.Definitions.SpellDef>
</Defs>
