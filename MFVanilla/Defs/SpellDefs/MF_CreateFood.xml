<?xml version="1.0" encoding="utf-8" ?>
<Defs>
  <MagicFramework.Definitions.SpellDef>
    <defName>MF_CreateFood</defName>
    <label>create food</label>
    <description>Conjures a simple meal that fades if left uneaten.</description>
    <gizmoIconPath>UI/Gizmos/Spells/MF_CreateFood</gizmoIconPath>
    <range>12</range>
    <castTimeTicks>20</castTimeTicks>

    <power>
      <casterLevelFactor>1</casterLevelFactor>
      <tiers>
        <li>
          <minPower>1</minPower>
          <tier>1</tier>
        </li>
        <li>
          <minPower>5</minPower>
          <tier>2</tier>
        </li>
        <li>
          <minPower>10</minPower>
          <tier>3</tier>
        </li>
      </tiers>
    </power>

    <targeting>
      <shape>Single</shape>
      <primaryTargetType>Cell</primaryTargetType>
      <pawnAffinity>All</pawnAffinity>
      <includePawns>false</includePawns>
      <includeBuildings>false</includeBuildings>
      <includeItems>false</includeItems>
      <allowSelfTarget>true</allowSelfTarget>
      <requireLineOfSight>true</requireLineOfSight>
      <requireWalkableCell>true</requireWalkableCell>
      <requireStandableCell>true</requireStandableCell>
      <range>12</range>
    </targeting>

    <requirements>
      <li Class="MagicFramework.Definitions.ManaRequirementDef">
        <debugLabel>Enough mana for Create Food</debugLabel>
        <amount>6</amount>
      </li>
      <li Class="MagicFramework.Definitions.CooldownRequirementDef">
        <debugLabel>Create Food cooldown ready</debugLabel>
        <cooldownTicks>180</cooldownTicks>
      </li>
    </requirements>

    <costs>
      <li Class="MagicFramework.Definitions.ManaCostDef">
        <debugLabel>Spend mana for Create Food</debugLabel>
        <amount>6</amount>
      </li>
      <li Class="MagicFramework.Definitions.CooldownCostDef">
        <debugLabel>Start Create Food cooldown</debugLabel>
        <cooldownTicks>180</cooldownTicks>
      </li>
    </costs>

    <actions>
      <li Class="MagicFramework.Definitions.SequenceActionDef">
        <debugLabel>Create Food sequence</debugLabel>
        <actions>
          <li Class="MagicFramework.Definitions.EffectActionDef">
            <debugLabel>Create Food conjuration effect</debugLabel>
            <effectDef>PsycastAreaEffect</effectDef>
            <locationSource>CurrentCell</locationSource>
          </li>
          <li Class="MagicFramework.Definitions.SpawnThingActionDef">
            <debugLabel>Create Food meal</debugLabel>
            <thingDef>MealSimple</thingDef>
            <tieredThingDefs>
              <li>
                <minTier>2</minTier>
                <thingDef>MealFine</thingDef>
              </li>
              <li>
                <minTier>3</minTier>
                <thingDef>MealLavish</thingDef>
              </li>
            </tieredThingDefs>
            <stackCount>1</stackCount>
            <scalableStackCount>
              <baseValue>1</baseValue>
              <perPower>0.1</perPower>
              <max>4</max>
            </scalableStackCount>
            <durationTicks>2500</durationTicks>
            <scalableDurationTicks>
              <baseValue>2500</baseValue>
              <perPower>75</perPower>
              <max>4000</max>
            </scalableDurationTicks>
            <forbidden>false</forbidden>
            <replaceExistingForCasterSpell>false</replaceExistingForCasterSpell>
          </li>
        </actions>
      </li>
    </actions>
  </MagicFramework.Definitions.SpellDef>
</Defs>
