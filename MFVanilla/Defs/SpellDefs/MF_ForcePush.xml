<?xml version="1.0" encoding="utf-8" ?>
<Defs>
  <MagicFramework.Definitions.SpellDef>
    <defName>MF_ForcePush</defName>
    <label>force push</label>
    <description>Unleashes a burst of force that shoves one hostile target away from the caster.</description>
    <gizmoIconPath>UI/Gizmos/Spells/MF_ForcePush</gizmoIconPath>
    <range>18</range>
    <castTimeTicks>30</castTimeTicks>

    <meta>
      <tier>1</tier>
      <elements>
        <li>MF_Element_Air</li>
        <li>MF_Element_Arcane</li>
      </elements>
      <domains>
        <li>MF_Domain_Aeromancy</li>
      </domains>
      <disciplines>
        <li>MF_Discipline_Control</li>
        <li>MF_Discipline_Movement</li>
      </disciplines>
      <tags>
        <li>MF_Tag_Hostile</li>
        <li>MF_Tag_Debuff</li>
      </tags>
    </meta>

    <learning>
      <canBeLearned>true</canBeLearned>
      <researchPrerequisites>
        <li>MFV_Aeromancy</li>
      </researchPrerequisites>
      <requirements>
        <li Class="MagicFramework.Definitions.ArcaneGiftRequirementDef" />
        <li Class="MagicFramework.Definitions.CasterLevelRequirementDef">
          <minimumLevel>1</minimumLevel>
        </li>
      </requirements>
    </learning>

    <targeting>
      <shape>Single</shape>
      <primaryTargetType>Pawn</primaryTargetType>
      <pawnAffinity>Foe</pawnAffinity>
      <includePawns>true</includePawns>
      <includeBuildings>false</includeBuildings>
      <includeItems>false</includeItems>
      <allowSelfTarget>false</allowSelfTarget>
      <requireLineOfSight>true</requireLineOfSight>
      <range>18</range>
    </targeting>

    <requirements>
      <li Class="MagicFramework.Definitions.ManaRequirementDef">
        <debugLabel>Enough mana for Force Push</debugLabel>
        <amount>10</amount>
      </li>
      <li Class="MagicFramework.Definitions.CooldownRequirementDef">
        <debugLabel>Force Push cooldown ready</debugLabel>
        <cooldownTicks>120</cooldownTicks>
      </li>
    </requirements>

    <costs>
      <li Class="MagicFramework.Definitions.ManaCostDef">
        <debugLabel>Spend mana for Force Push</debugLabel>
        <amount>10</amount>
      </li>
      <li Class="MagicFramework.Definitions.CooldownCostDef">
        <debugLabel>Start Force Push cooldown</debugLabel>
        <cooldownTicks>120</cooldownTicks>
      </li>
    </costs>

    <actions>
      <li Class="MagicFramework.Definitions.SequenceActionDef">
        <debugLabel>Force Push sequence</debugLabel>
        <actions>
          <li Class="MagicFramework.Definitions.EffectActionDef">
            <debugLabel>Force Push cast effect</debugLabel>
            <effectDef>PsycastAreaEffect</effectDef>
            <locationSource>Caster</locationSource>
            <attachToTarget>false</attachToTarget>
          </li>
          <li Class="MagicFramework.Definitions.EffectActionDef">
            <debugLabel>Force Push target effect</debugLabel>
            <effectDef>PsycastPsychicEffect</effectDef>
            <locationSource>CurrentTarget</locationSource>
            <attachToTarget>true</attachToTarget>
          </li>
          <li Class="MagicFramework.Definitions.KnockbackActionDef">
            <debugLabel>Force Push knockback</debugLabel>
            <distance>4</distance>
            <requireStandableDestination>true</requireStandableDestination>
            <requireWalkableDestination>true</requireWalkableDestination>
            <allowHitCasterCell>false</allowHitCasterCell>
          </li>
        </actions>
      </li>
    </actions>
  </MagicFramework.Definitions.SpellDef>
</Defs>
