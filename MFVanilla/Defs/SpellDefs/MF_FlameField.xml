<?xml version="1.0" encoding="utf-8" ?>
<Defs>
  <MagicFramework.Definitions.SpellDef>
    <defName>MF_FlameField</defName>
    <label>flame field</label>
    <description>Creates a persistent circular field of magical fire that burns creatures standing within it.</description>
    <gizmoIconPath>UI/Gizmos/Spells/MF_FlameField</gizmoIconPath>
    <range>20</range>
    <castTimeTicks>45</castTimeTicks>

    <meta>
      <tier>2</tier>
      <elements>
        <li>MF_Element_Fire</li>
      </elements>
      <domains>
        <li>MF_Domain_Pyromancy</li>
      </domains>
      <disciplines>
        <li>MF_Discipline_Combat</li>
        <li>MF_Discipline_Warding</li>
      </disciplines>
      <tags>
        <li>MF_Tag_Area</li>
        <li>MF_Tag_Hostile</li>
        <li>MF_Tag_DirectDamage</li>
        <li>MF_Tag_WeatherSensitive</li>
      </tags>
    </meta>

    <learning>
      <canBeLearned>true</canBeLearned>
      <researchPrerequisites>
        <li>MFV_Pyromancy</li>
      </researchPrerequisites>
      <requirements>
        <li Class="MagicFramework.Definitions.ArcaneGiftRequirementDef" />
        <li Class="MagicFramework.Definitions.CasterLevelRequirementDef">
          <minimumLevel>3</minimumLevel>
        </li>
      </requirements>
    </learning>

    <targeting>
      <shape>Single</shape>
      <primaryTargetType>Cell</primaryTargetType>
      <pawnAffinity>All</pawnAffinity>
      <includePawns>false</includePawns>
      <includeBuildings>false</includeBuildings>
      <includeItems>false</includeItems>
      <allowSelfTarget>false</allowSelfTarget>
      <requireLineOfSight>true</requireLineOfSight>
      <requireWalkableCell>true</requireWalkableCell>
      <range>20</range>
    </targeting>

    <requirements>
      <li Class="MagicFramework.Definitions.ManaRequirementDef">
        <debugLabel>Enough mana for Flame Field</debugLabel>
        <amount>16</amount>
      </li>
      <li Class="MagicFramework.Definitions.CooldownRequirementDef">
        <debugLabel>Flame Field cooldown ready</debugLabel>
        <cooldownTicks>240</cooldownTicks>
      </li>
    </requirements>

    <costs>
      <li Class="MagicFramework.Definitions.ManaCostDef">
        <debugLabel>Spend mana for Flame Field</debugLabel>
        <amount>16</amount>
      </li>
      <li Class="MagicFramework.Definitions.CooldownCostDef">
        <debugLabel>Start Flame Field cooldown</debugLabel>
        <cooldownTicks>240</cooldownTicks>
      </li>
    </costs>

    <actions>
      <li Class="MagicFramework.Definitions.SequenceActionDef">
        <debugLabel>Flame Field sequence</debugLabel>
        <actions>
          <li Class="MagicFramework.Definitions.PersistentAreaZoneActionDef">
            <debugLabel>Flame Field area zone</debugLabel>
            <markerThingDef>MF_FlameFieldMarker</markerThingDef>
            <zoneRadius>3.4</zoneRadius>
            <pulseIntervalTicks>30</pulseIntervalTicks>
            <ambientEffectDef>Vaporize_Heatwave</ambientEffectDef>
            <visualPulseIntervalTicks>90</visualPulseIntervalTicks>
            <emitVisualFromMarkers>false</emitVisualFromMarkers>
            <maxVisualMarkersPerPulse>1</maxVisualMarkersPerPulse>
            <durationTicks>720</durationTicks>
            <failsafeDurationTicks>900</failsafeDurationTicks>
            <pulseAtCenter>true</pulseAtCenter>
            <pawnAffinity>All</pawnAffinity>
            <includeCaster>false</includeCaster>
            <replaceExistingForCaster>true</replaceExistingForCaster>
            <actions>
              <li Class="MagicFramework.Definitions.TerrainPatchActionDef">
                <debugLabel>Flame Field melt snow and ice</debugLabel>
                <centerSource>CurrentCell</centerSource>
                <radius>3.4</radius>
                <meltIce>true</meltIce>
                <removeSnow>true</removeSnow>
                <skipRoofedCells>false</skipRoofedCells>
              </li>
              <li Class="MagicFramework.Definitions.DamageActionDef">
                <debugLabel>Flame Field damage</debugLabel>
                <amount>5</amount>
                <damageDef>Flame</damageDef>
              </li>
              <li Class="MagicFramework.Definitions.ApplyHediffActionDef">
                <debugLabel>Flame Field burn</debugLabel>
                <hediffDef>Burn</hediffDef>
                <severity>0.06</severity>
              </li>
            </actions>
          </li>
        </actions>
      </li>
    </actions>
  </MagicFramework.Definitions.SpellDef>
</Defs>
