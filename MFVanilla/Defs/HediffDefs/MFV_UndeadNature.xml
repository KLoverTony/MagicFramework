<?xml version="1.0" encoding="utf-8" ?>
<Defs>

  <HediffDef>
    <defName>MFV_UndeadNature</defName>
    <label>undead nature</label>
    <description>This pawn carries the shared metaphysical state of undeath.</description>
    <hediffClass>Hediff</hediffClass>
    <isBad>false</isBad>
    <scenarioCanAdd>false</scenarioCanAdd>
  </HediffDef>

  <HediffDef>
    <defName>MFV_SkeletalBody</defName>
    <label>skeletal body</label>
    <description>This pawn has a skeletal undead body.</description>
    <hediffClass>Hediff</hediffClass>
    <isBad>false</isBad>
    <scenarioCanAdd>false</scenarioCanAdd>
    <defaultLabelColor>(0.75, 0.75, 0.75)</defaultLabelColor>
  </HediffDef>

  <HediffDef>
    <defName>MFV_SkeletalLimitations</defName>
    <label>skeletal limitations</label>
    <description>This skeletal body has limited awareness and dexterity.</description>
    <hediffClass>Hediff</hediffClass>
    <isBad>false</isBad>
    <scenarioCanAdd>false</scenarioCanAdd>
    <stages>
      <li>
        <capMods>
          <li>
            <capacity>Consciousness</capacity>
            <setMax>0.5</setMax>
          </li>
          <li>
            <capacity>Manipulation</capacity>
            <setMax>0.5</setMax>
          </li>
          <li>
            <capacity>Moving</capacity>
            <setMax>0.75</setMax>
          </li>
          <li>
            <capacity>Talking</capacity>
            <setMax>0</setMax>
          </li>
        </capMods>
      </li>
    </stages>
    <defaultLabelColor>(0.65, 0.65, 0.65)</defaultLabelColor>
  </HediffDef>

</Defs>
