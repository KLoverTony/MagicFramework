<?xml version="1.0" encoding="utf-8" ?>
<Defs>
  <HediffDef>
    <defName>MF_GenericSpellStatusCue</defName>
    <label>affected by magic</label>
    <description>This pawn is affected by a spell.</description>
    <hediffClass>MagicFramework.Core.SpellStatusCueHediff</hediffClass>
    <isBad>false</isBad>
    <scenarioCanAdd>false</scenarioCanAdd>
    <initialSeverity>0.01</initialSeverity>
  </HediffDef>

  <HediffDef>
    <defName>MF_Hasted</defName>
    <label>hasted</label>
    <description>This pawn is moving with magically enhanced speed.</description>
    <hediffClass>HediffWithComps</hediffClass>
    <isBad>false</isBad>
    <scenarioCanAdd>false</scenarioCanAdd>
    <initialSeverity>0.01</initialSeverity>
  </HediffDef>

  <HediffDef>
    <defName>MF_Mighty</defName>
    <label>mighty</label>
    <description>This pawn is strengthened by maintained magic.</description>
    <hediffClass>HediffWithComps</hediffClass>
    <isBad>false</isBad>
    <scenarioCanAdd>false</scenarioCanAdd>
    <initialSeverity>0.01</initialSeverity>
  </HediffDef>

  <HediffDef>
    <defName>MF_Weakened</defName>
    <label>weakened</label>
    <description>This pawn is suffering backlash from broken strengthening magic.</description>
    <hediffClass>HediffWithComps</hediffClass>
    <isBad>true</isBad>
    <scenarioCanAdd>false</scenarioCanAdd>
    <initialSeverity>0.01</initialSeverity>
  </HediffDef>

  <HediffDef>
    <defName>MF_ForceFielded</defName>
    <label>force fielded</label>
    <description>This pawn is protected by a maintained magical force field.</description>
    <hediffClass>HediffWithComps</hediffClass>
    <isBad>false</isBad>
    <scenarioCanAdd>false</scenarioCanAdd>
    <initialSeverity>0.01</initialSeverity>
  </HediffDef>

  <HediffDef>
    <defName>MF_ManaShielded</defName>
    <label>mana shielded</label>
    <description>This pawn is protected by a shield that consumes mana to absorb incoming damage.</description>
    <hediffClass>HediffWithComps</hediffClass>
    <isBad>false</isBad>
    <scenarioCanAdd>false</scenarioCanAdd>
    <initialSeverity>0.01</initialSeverity>
  </HediffDef>

  <HediffDef>
    <defName>MF_Frozen</defName>
    <label>frozen</label>
    <description>This pawn is slowed by lingering frost magic.</description>
    <hediffClass>HediffWithComps</hediffClass>
    <isBad>true</isBad>
    <scenarioCanAdd>false</scenarioCanAdd>
    <initialSeverity>0.01</initialSeverity>
  </HediffDef>

  <HediffDef>
    <defName>MF_Waterbound</defName>
    <label>waterbound</label>
    <description>This pawn is restrained by animated water.</description>
    <hediffClass>HediffWithComps</hediffClass>
    <isBad>true</isBad>
    <scenarioCanAdd>false</scenarioCanAdd>
    <initialSeverity>0.01</initialSeverity>
  </HediffDef>

  <HediffDef>
    <defName>MF_HeldUnder</defName>
    <label>held under</label>
    <description>This pawn is being forced beneath animated water and is struggling to stay conscious.</description>
    <hediffClass>MagicFramework.Core.SpellDrowningHediff</hediffClass>
    <isBad>true</isBad>
    <scenarioCanAdd>false</scenarioCanAdd>
    <initialSeverity>0.01</initialSeverity>
    <stages>
      <li>
        <capMods>
          <li>
            <capacity>Consciousness</capacity>
            <offset>-0.04</offset>
          </li>
        </capMods>
      </li>
      <li>
        <minSeverity>0.25</minSeverity>
        <capMods>
          <li>
            <capacity>Consciousness</capacity>
            <offset>-0.25</offset>
          </li>
        </capMods>
      </li>
      <li>
        <minSeverity>0.65</minSeverity>
        <capMods>
          <li>
            <capacity>Consciousness</capacity>
            <offset>-0.75</offset>
          </li>
        </capMods>
      </li>
      <li>
        <minSeverity>0.9</minSeverity>
        <capMods>
          <li>
            <capacity>Consciousness</capacity>
            <setMax>0.05</setMax>
          </li>
        </capMods>
      </li>
    </stages>
  </HediffDef>
</Defs>
