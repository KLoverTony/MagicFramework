<?xml version="1.0" encoding="utf-8" ?>
<Defs>
  <HediffDef>
    <defName>MF_GenericSpellStatusCue</defName>
    <label>affected by magic</label>
    <description>This pawn is affected by a spell.</description>
    <hediffClass>MagicFramework.Core.SpellStatusCueHediff</hediffClass>
    <isBad>false</isBad>
    <scenarioCanAdd>false</scenarioCanAdd>
    <initialSeverity>0.01</initialSeverity>
  </HediffDef>

  <HediffDef>
    <defName>MF_Hasted</defName>
    <label>hasted</label>
    <description>This pawn's movement speed is increased by 35%.</description>
    <hediffClass>HediffWithComps</hediffClass>
    <isBad>false</isBad>
    <scenarioCanAdd>false</scenarioCanAdd>
    <initialSeverity>0.01</initialSeverity>
  </HediffDef>

  <HediffDef>
    <defName>MF_BlessedVigor</defName>
    <label>blessed with vigor</label>
    <description>This pawn's movement speed is increased by 12%, and general labor speed is increased by 10%.</description>
    <hediffClass>HediffWithComps</hediffClass>
    <isBad>false</isBad>
    <scenarioCanAdd>false</scenarioCanAdd>
    <initialSeverity>0.01</initialSeverity>
  </HediffDef>

  <HediffDef>
    <defName>MF_Mighty</defName>
    <label>mighty</label>
    <description>This pawn's melee damage is increased by 35%, and carrying capacity is increased by 25 kg.</description>
    <hediffClass>HediffWithComps</hediffClass>
    <isBad>false</isBad>
    <scenarioCanAdd>false</scenarioCanAdd>
    <initialSeverity>0.01</initialSeverity>
  </HediffDef>

  <HediffDef>
    <defName>MF_Weakened</defName>
    <label>weakened</label>
    <description>This pawn's melee damage is reduced by 25%, and carrying capacity is reduced by 15 kg.</description>
    <hediffClass>HediffWithComps</hediffClass>
    <isBad>true</isBad>
    <scenarioCanAdd>false</scenarioCanAdd>
    <initialSeverity>0.01</initialSeverity>
  </HediffDef>

  <HediffDef>
    <defName>MF_ForceFielded</defName>
    <label>force fielded</label>
    <description>This pawn is protected by a maintained force field that reduces incoming damage by 50% while the caster keeps focus.</description>
    <hediffClass>HediffWithComps</hediffClass>
    <isBad>false</isBad>
    <scenarioCanAdd>false</scenarioCanAdd>
    <initialSeverity>0.01</initialSeverity>
  </HediffDef>

  <HediffDef>
    <defName>MF_ManaShielded</defName>
    <label>mana shielded</label>
    <description>This pawn is protected by a shield that spends the caster's mana to fully absorb incoming damage, and costs upkeep while maintained.</description>
    <hediffClass>HediffWithComps</hediffClass>
    <isBad>false</isBad>
    <scenarioCanAdd>false</scenarioCanAdd>
    <initialSeverity>0.01</initialSeverity>
  </HediffDef>

  <HediffDef>
    <defName>MF_Regenerating</defName>
    <label>regenerating</label>
    <description>This pawn's wounds are being gradually restored by vital magic.</description>
    <hediffClass>HediffWithComps</hediffClass>
    <isBad>false</isBad>
    <scenarioCanAdd>false</scenarioCanAdd>
    <initialSeverity>0.01</initialSeverity>
  </HediffDef>

  <HediffDef>
    <defName>MF_SharedEssence</defName>
    <label>shared essence</label>
    <description>This pawn's life force has been temporarily entwined with another through resurrection magic, leaving consciousness dimmed while the bond settles.</description>
    <hediffClass>HediffWithComps</hediffClass>
    <isBad>true</isBad>
    <scenarioCanAdd>false</scenarioCanAdd>
    <initialSeverity>1</initialSeverity>
    <stages>
      <li>
        <capMods>
          <li>
            <capacity>Consciousness</capacity>
            <setMax>0.5</setMax>
          </li>
        </capMods>
      </li>
    </stages>
  </HediffDef>

  <HediffDef>
    <defName>MF_Frozen</defName>
    <label>frozen</label>
    <description>This pawn's movement speed is reduced by 45%.</description>
    <hediffClass>HediffWithComps</hediffClass>
    <isBad>true</isBad>
    <scenarioCanAdd>false</scenarioCanAdd>
    <initialSeverity>0.01</initialSeverity>
  </HediffDef>

  <HediffDef>
    <defName>MF_Waterbound</defName>
    <label>waterbound</label>
    <description>This pawn's movement speed is reduced by 65% by animated water.</description>
    <hediffClass>HediffWithComps</hediffClass>
    <isBad>true</isBad>
    <scenarioCanAdd>false</scenarioCanAdd>
    <initialSeverity>0.01</initialSeverity>
  </HediffDef>

  <HediffDef>
    <defName>MF_HeldUnder</defName>
    <label>held under</label>
    <description>This pawn is being forced beneath animated water and is struggling to stay conscious.</description>
    <hediffClass>MagicFramework.Core.SpellDrowningHediff</hediffClass>
    <isBad>true</isBad>
    <scenarioCanAdd>false</scenarioCanAdd>
    <initialSeverity>0.01</initialSeverity>
    <stages>
      <li>
        <capMods>
          <li>
            <capacity>Consciousness</capacity>
            <offset>-0.04</offset>
          </li>
        </capMods>
      </li>
      <li>
        <minSeverity>0.25</minSeverity>
        <capMods>
          <li>
            <capacity>Consciousness</capacity>
            <offset>-0.25</offset>
          </li>
        </capMods>
      </li>
      <li>
        <minSeverity>0.65</minSeverity>
        <capMods>
          <li>
            <capacity>Consciousness</capacity>
            <offset>-0.75</offset>
          </li>
        </capMods>
      </li>
      <li>
        <minSeverity>0.9</minSeverity>
        <capMods>
          <li>
            <capacity>Consciousness</capacity>
            <setMax>0.05</setMax>
          </li>
        </capMods>
      </li>
    </stages>
  </HediffDef>
</Defs>
