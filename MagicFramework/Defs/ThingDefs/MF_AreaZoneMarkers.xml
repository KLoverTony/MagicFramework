<?xml version="1.0" encoding="utf-8" ?>
<Defs>
  <ThingDef ParentName="BuildingBase">
    <defName>MF_FlameFieldMarker</defName>
    <label>flame field marker</label>
    <description>A hidden persistent marker used to anchor a flame field runtime zone.</description>
    <thingClass>MagicFramework.Core.SpellPersistentMarkerThing</thingClass>
    <selectable>false</selectable>
    <neverMultiSelect>true</neverMultiSelect>
    <drawerType>None</drawerType>
    <altitudeLayer>MoteOverhead</altitudeLayer>
    <tickerType>Never</tickerType>
    <passability>PassThroughOnly</passability>
    <pathCost>0</pathCost>
    <useHitPoints>false</useHitPoints>
    <fillPercent>0.01</fillPercent>
    <statBases>
      <MaxHitPoints>1</MaxHitPoints>
    </statBases>
    <building>
      <isInert>true</isInert>
    </building>
  </ThingDef>
</Defs>
