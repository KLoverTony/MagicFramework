<?xml version="1.0" encoding="utf-8" ?>
<Defs>

  <ThoughtDef>
    <defName>AF_EerieColdThought</defName>
    <workerClass>ThoughtWorker_Hediff</workerClass>
    <hediff>AF_EerieCold</hediff>
    <developmentalStageFilter>Baby, Child, Adult</developmentalStageFilter>
    <stages>
      <li>
        <label>eerie cold</label>
        <description>A cold presence is lingering nearby.</description>
        <baseMoodEffect>-5</baseMoodEffect>
      </li>
    </stages>
  </ThoughtDef>

  <ThoughtDef>
    <defName>AF_UnnervingAuraThought</defName>
    <durationDays>0.125</durationDays>
    <stackLimit>1</stackLimit>
    <developmentalStageFilter>Baby, Child, Adult</developmentalStageFilter>
    <stages>
      <li>
        <label>unnerved by undead</label>
        <description>The presence of undeath still lingers nearby.</description>
        <baseMoodEffect>-4</baseMoodEffect>
      </li>
    </stages>
  </ThoughtDef>

  <ThoughtDef>
    <defName>AF_StrongUnnervingAuraThought</defName>
    <durationDays>0.125</durationDays>
    <stackLimit>1</stackLimit>
    <developmentalStageFilter>Baby, Child, Adult</developmentalStageFilter>
    <stages>
      <li>
        <label>deeply unnerved by undead</label>
        <description>A powerful undead presence has left this pawn shaken.</description>
        <baseMoodEffect>-8</baseMoodEffect>
      </li>
    </stages>
  </ThoughtDef>

  <ThoughtDef>
    <defName>AF_SpectreVisitedLovedOne</defName>
    <durationDays>1.5</durationDays>
    <stackLimit>1</stackLimit>
    <stages>
      <li>
        <label>visited remembered love</label>
        <description>The echo of a beloved presence steadies this spirit.</description>
        <baseMoodEffect>12</baseMoodEffect>
      </li>
    </stages>
  </ThoughtDef>

  <ThoughtDef>
    <defName>AF_SpectreVisitedFamily</defName>
    <durationDays>1.2</durationDays>
    <stackLimit>1</stackLimit>
    <stages>
      <li>
        <label>visited remembered family</label>
        <description>A familiar mortal bond helps this spirit remain coherent.</description>
        <baseMoodEffect>7</baseMoodEffect>
      </li>
    </stages>
  </ThoughtDef>

  <ThoughtDef>
    <defName>AF_SpectreVisitedAnchor</defName>
    <durationDays>0.8</durationDays>
    <stackLimit>1</stackLimit>
    <stages>
      <li>
        <label>returned to anchor</label>
        <description>The haunting anchor gives this spirit a brief sense of shape.</description>
        <baseMoodEffect>4</baseMoodEffect>
      </li>
    </stages>
  </ThoughtDef>

</Defs>
