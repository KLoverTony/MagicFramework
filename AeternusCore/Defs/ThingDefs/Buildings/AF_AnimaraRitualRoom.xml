<?xml version="1.0" encoding="utf-8" ?>
<Defs>

  <!-- Base class for Animara floor coverings -->
  <ThingDef Name="AF_AnimaraFloorBase" ParentName="BuildingBase" Abstract="True">
    <thingClass>Building</thingClass>
    <category>Building</category>
    <altitudeLayer>FloorCoverings</altitudeLayer>
    <passability>Standable</passability>
    <pathCost>0</pathCost>
    <fillPercent>0</fillPercent>
    <selectable>true</selectable>
    <useHitPoints>true</useHitPoints>
    <terrainAffordanceNeeded>Light</terrainAffordanceNeeded>
    <blocksAltitudes>
      <li>FloorCoverings</li>
    </blocksAltitudes>
    <statBases>
      <MaxHitPoints>80</MaxHitPoints>
      <WorkToBuild>400</WorkToBuild>
      <Flammability>0.3</Flammability>
      <Beauty>2</Beauty>
      <Mass>10</Mass>
    </statBases>
    <costList>
      <Cloth>30</Cloth>
      <Steel>10</Steel>
    </costList>
    <building>
      <isEdifice>false</isEdifice>
      <isInert>true</isInert>
      <ai_chillDestination>false</ai_chillDestination>
    </building>
  </ThingDef>

  <!-- Center Piece -->
  <ThingDef ParentName="AF_AnimaraFloorBase">
    <defName>AF_AnimaraRitualCenter</defName>
    <label>animara ritual center</label>
    <description>The central focal point of the Animara ritual room floor.</description>
    <graphicData>
      <texPath>Things/RitualRooms/AnimaraRitualRoom/Animara_Ritual_center</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <drawSize>(3,3)</drawSize>
    </graphicData>
    <size>(3,3)</size>
    <designationCategory>Misc</designationCategory>
    <researchPrerequisites>
      <li>AF_AnimaraSoulbinding</li>
    </researchPrerequisites>
    <uiOrder>2070</uiOrder>
    <rotatable>false</rotatable>
    <statBases>
      <WorkToBuild>800</WorkToBuild>
      <Beauty>5</Beauty>
    </statBases>
    <costList>
      <Cloth>60</Cloth>
      <Steel>20</Steel>
    </costList>
    <comps>
      <li Class="AeternusFaith.CompProperties_PlaceLinkedBuildable">
        <targetDef>AF_OssuaryBoneBox</targetDef>
        <offset>(0,0,0)</offset>
        <commandLabel>Build ossuary bone box</commandLabel>
        <commandDescription>Place a normal construction blueprint for an ossuary bone box in the center of this circle.</commandDescription>
        <commandIconPath>Things/Graves/OssuaryBox_south</commandIconPath>
      </li>
      <li Class="AeternusFaith.CompProperties_BonewrightAnointment">
        <commandIconPath>Things/RitualRooms/AnimaraRitualRoom/Animara_Ritual_center</commandIconPath>
      </li>
    </comps>
  </ThingDef>

  <!-- Animara Lectern -->
  <ThingDef ParentName="BuildingBase">
    <defName>AF_AnimaraLectern</defName>
    <label>animara lectern</label>
    <description>A ceremonial lectern used for Animara sacred rites, attuned to the Animara ritual center.</description>
    <thingClass>Building</thingClass>
    <category>Building</category>
    <graphicData>
      <texPath>Things/RitualLectern/Ossanith_Lectern</texPath>
      <graphicClass>Graphic_Multi</graphicClass>
      <drawSize>(1,1)</drawSize>
    </graphicData>
    <drawerType>MapMeshOnly</drawerType>
    <minifiedDef>MinifiedThing</minifiedDef>
    <size>(1,1)</size>
    <altitudeLayer>Building</altitudeLayer>
    <passability>PassThroughOnly</passability>
    <pathCost>30</pathCost>
    <fillPercent>0.35</fillPercent>
    <selectable>true</selectable>
    <useHitPoints>true</useHitPoints>
    <rotatable>true</rotatable>
    <defaultPlacingRot>South</defaultPlacingRot>
    <hasInteractionCell>true</hasInteractionCell>
    <interactionCellOffset>(0,0,-1)</interactionCellOffset>
    <terrainAffordanceNeeded>Light</terrainAffordanceNeeded>
    <uiOrder>2076</uiOrder>
    <researchPrerequisites>
      <li>AF_AnimaraSoulbinding</li>
    </researchPrerequisites>
    <thingCategories>
      <li>BuildingsFurniture</li>
    </thingCategories>
    <statBases>
      <MaxHitPoints>140</MaxHitPoints>
      <WorkToBuild>700</WorkToBuild>
      <Flammability>0.20</Flammability>
      <Beauty>5</Beauty>
      <Mass>25</Mass>
    </statBases>
    <costList>
      <WoodLog>45</WoodLog>
    </costList>
    <building>
      <isInert>true</isInert>
      <ai_chillDestination>false</ai_chillDestination>
    </building>
    <surfaceType>Item</surfaceType>
    <comps>
      <li Class="CompProperties_Forbiddable"/>
      <li Class="AeternusFaith.CompProperties_BonewrightLecternRitualFallback">
        <supportedCircleDefs>
          <li>AF_AnimaraRitualCenter</li>
        </supportedCircleDefs>
        <commandIconPath>Things/RitualLectern/Ossanith_Lectern</commandIconPath>
      </li>
      <li Class="AeternusFaith.CompProperties_OssanithOssuaryRitual">
        <circleDef>AF_AnimaraRitualCenter</circleDef>
        <ossuaryDef>AF_OssuaryBoneBox</ossuaryDef>
        <commandLabel>Begin animara ossuary rite</commandLabel>
        <commandDescription>Begin an Animara ossuary rite. Requires an orthogonally adjacent Animara Ritual Center with a completed ossuary in its center.</commandDescription>
        <commandIconPath>Things/Graves/OssuaryBox_south</commandIconPath>
        <hideWhenCircleAbsent>true</hideWhenCircleAbsent>
      </li>
      <li Class="AeternusFaith.CompProperties_AnimaraRevenantRitual">
        <circleDef>AF_AnimaraRitualCenter</circleDef>
        <commandLabel>Animate Echobound Revenant</commandLabel>
        <commandDescription>Begin an Animara rite to animate a corpse as an Echobound Revenant. Requires an orthogonally adjacent Animara Ritual Center.</commandDescription>
        <commandIconPath>Things/RitualRooms/AnimaraRitualRoom/Animara_Ritual_center</commandIconPath>
        <hideWhenCircleAbsent>true</hideWhenCircleAbsent>
      </li>
    </comps>
  </ThingDef>

</Defs>
