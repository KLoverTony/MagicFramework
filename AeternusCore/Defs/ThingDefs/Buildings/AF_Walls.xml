    <label>granite flat wall</label>
    <description>An impassable granite wall faced with austere ceremonial stonework.</description>
    <graphicData>
      <texPath>Things/Walls/Flat wall 1</texPath>
      <graphicClass>Graphic_Single</graphicClass>
    </graphicData>
