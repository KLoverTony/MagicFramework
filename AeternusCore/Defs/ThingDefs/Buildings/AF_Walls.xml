  <ThingDef ParentName="AF_DecorativeWallBase">
    <defName>AF_AlcoveWallFilledGranite</defName>
    <label>filled granite alcove wall</label>
    <description>An impassable granite alcove wall sealing an ossuary bone box within its recess.</description>
    <thingClass>AeternusFaith.Building_FilledAlcoveWall</thingClass>
    <graphicData>
      <texPath>Things/Walls/Alcove wall - filled</texPath>
      <graphicClass>Graphic_Single</graphicClass>
    </graphicData>
    <comps>
      <li Class="CompProperties_MeditationFocus">
        <statDef>MeditationFocusStrength</statDef>
        <focusTypes>
          <li>Minimal</li>
        </focusTypes>
      </li>
      <li Class="AeternusFaith.CompProperties_OssuaryObituary"/>
    </comps>
  </ThingDef>

  <ThingDef ParentName="AF_DecorativeWallBase">
    <defName>AF_AlcoveWallFilledSlate</defName>
    <label>filled slate alcove wall</label>
    <description>An impassable slate alcove wall sealing an ossuary bone box within its recess.</description>
    <thingClass>AeternusFaith.Building_FilledAlcoveWall</thingClass>
